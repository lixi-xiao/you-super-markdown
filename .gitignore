# ===== 数据目录（用户数据、日志、封禁等敏感文件，不入库）=====
data/

# ===== 构建产物与更新包（统一存放于工作区 update-package 目录）=====
*.tar.gz
*.zip
staging/
inc-stage/
v221-base/

# ===== 敏感文件 =====
.pw.txt
*.pem
*.key
*.secret

# ===== 日志 =====
*.log

# ===== 系统文件 =====
.DS_Store
Thumbs.db
__pycache__/

# ===== 说明文档（统一存放于工作区根目录，主库不放文档）=====
*.md
# README.md 例外（仓库门面，随仓库发布）
!README.md
# HELP.md 例外（使用与部署帮助文档，面向部署者与二次开发者，随仓库发布）
!HELP.md
# docs/ 目录（含敏感运维信息，不应进入公开仓库）
docs/

# _hfish_bridge.php 为运行时依赖（ysm-hfish-sync.py 调用、ysm-guard.py 监控），
# v5.0.1 起随包发布（此前被忽略导致更新时被 rsync --delete 删除、蜜罐联动静默失效）