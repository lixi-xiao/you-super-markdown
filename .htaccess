# Apache 配置（Nginx 用户请参考 nginx-site.conf）
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # v5.0.0：data/ 目录安全兜底（Apache 部署）——拒绝 Web 访问数据库/密钥/JSON 等敏感文件
    # （与 nginx-site.conf 的 data/ 规则等价；data/images、data/videos 仍可公开访问）
    RewriteRule (^|/)data/.*\.(db|db-wal|db-shm|sqlite|sqlite3|json)$ - [F,L,NC]

    # v5.0.0：拒绝所有点文件（.env/.git/.jwt_secret/.app_secret/.fp_hmac/.audit_chain/.htaccess 等）；
    # 放行 ACME 验证目录 .well-known（Let's Encrypt 续期依赖）
    RewriteRule (^|/)\.(?!well-known/) - [F,L]

    # 如果是真实存在的文件或目录，直接访问
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    ErrorDocument 404 /404.php

    # 其他所有不存在的请求 -> index.php（保留原始 query string）
    RewriteRule ^(.*)$ index.php [L,QSA]
</IfModule>
