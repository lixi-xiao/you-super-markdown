#!/bin/bash
WEB_ROOT="${YM_WEB_ROOT:-/var/www/you-markdown}"
ENTRIES_FILE="$WEB_ROOT/data/.entries.json"
USERS_FILE="$WEB_ROOT/data/.users.json"

case "${1:-}" in
    login)
        ENTRY_TOKEN=$(openssl rand -base64 12 | tr -d '=+/' | cut -c1-12)
        OTP=$(openssl rand -base64 12 | tr -d '=+/' | cut -c1-12)
        OTP_HASH=$(php -r "echo password_hash('$OTP', PASSWORD_DEFAULT);")
        EXPIRES=$(( $(date +%s) + 600 ))

        php -r "require_once '$WEB_ROOT/utils.php'; addEntry('$ENTRY_TOKEN', '$OTP_HASH', $EXPIRES);" 2>/dev/null

        echo ""
        echo "============================================"
        echo "  管理入口（仅显示一次，10分钟有效）"
        echo "============================================"
        echo ""
        echo "  入口 URL: https://youmarkdown.example.com/admin/entry/$ENTRY_TOKEN"
        echo "  一次性密码: $OTP"
        echo ""
        echo "  ⚠️ 请立即保存！"
        echo "============================================"
        echo ""
        ;;

    create-station)
        NAME="${2:-}"
        if [ -z "$NAME" ]; then echo "用法: ym-admin create-station <站长名称>"; exit 1; fi
        QQ="station_$(openssl rand -hex 4)"
        # v2.6.4：生成满足密码策略（≥8 位 + 大写 + 小写 + 数字）的随机密码
        for i in 1 2 3 4 5; do
            PWD=$(openssl rand -base64 12 | tr -d '=+/')
            if [ ${#PWD} -ge 8 ] && echo "$PWD" | grep -q '[a-z]' && echo "$PWD" | grep -q '[A-Z]' && echo "$PWD" | grep -q '[0-9]'; then
                break
            fi
        done
        php -r "
            require_once '$WEB_ROOT/utils.php';
            \$u = loadUsers();
            \$u[] = ['id'=>bin2hex(random_bytes(8)),'qq'=>'$QQ','nickname'=>'$NAME','password'=>password_hash('$PWD',PASSWORD_DEFAULT),'role'=>'station_admin','created'=>date('Y-m-d H:i:s')];
            saveUsers(\$u);
        " 2>/dev/null
        echo "站长账号已创建: $NAME (QQ: $QQ, 密码: $PWD)"
        ;;

    create-author)
        NAME="${2:-}"
        STATION_ID="${3:-}"
        if [ -z "$NAME" ]; then echo "用法: ym-admin create-author <写作者名称> [站长ID]"; exit 1; fi
        QQ="author_$(openssl rand -hex 4)"
        # v2.6.4：生成满足密码策略（≥8 位 + 大写 + 小写 + 数字）的随机密码
        for i in 1 2 3 4 5; do
            PWD=$(openssl rand -base64 12 | tr -d '=+/')
            if [ ${#PWD} -ge 8 ] && echo "$PWD" | grep -q '[a-z]' && echo "$PWD" | grep -q '[A-Z]' && echo "$PWD" | grep -q '[0-9]'; then
                break
            fi
        done
        php -r "
            require_once '$WEB_ROOT/utils.php';
            \$u = loadUsers();
            \$u[] = ['id'=>bin2hex(random_bytes(8)),'qq'=>'$QQ','nickname'=>'$NAME','password'=>password_hash('$PWD',PASSWORD_DEFAULT),'role'=>'author','station_id'=>'$STATION_ID','created'=>date('Y-m-d H:i:s')];
            saveUsers(\$u);
        " 2>/dev/null
        echo "写作者账号已创建: $NAME (QQ: $QQ, 密码: $PWD)"
        ;;

    revoke-user)
        USER_ID="${2:-}"
        if [ -z "$USER_ID" ]; then echo "用法: ym-admin revoke-user <用户ID>"; exit 1; fi
        php -r "require_once '$WEB_ROOT/utils.php'; db_exec('DELETE FROM users WHERE id = ?', ['$USER_ID']);" 2>/dev/null
        echo "用户已吊销: $USER_ID"
        ;;

    backup)
        BACKUP_DIR="/opt/you-markdown/backups"
        mkdir -p "$BACKUP_DIR"
        tar -czf "$BACKUP_DIR/ym-backup-$(date +%Y%m%d-%H%M%S).tar.gz" -C "$WEB_ROOT" data/ 2>/dev/null
        echo "备份完成: $BACKUP_DIR"
        ;;

    status)
        echo "守护进程: $(systemctl is-active ym-guard 2>/dev/null || echo 'unknown')"
        echo "Nginx: $(systemctl is-active nginx 2>/dev/null || echo 'unknown')"
        PHP_FPM_SVC="php$(php -r 'echo PHP_MAJOR_VERSION.".".PHP_MINOR_VERSION;')-fpm"
        echo "PHP-FPM: $(systemctl is-active $PHP_FPM_SVC 2>/dev/null || systemctl is-active php-fpm 2>/dev/null || echo 'unknown')"
        echo "用户数: $(php -r "require_once '$WEB_ROOT/utils.php'; echo count(loadUsers());" 2>/dev/null)"
        ;;

    log-verify)
        php -r "
            require_once '$WEB_ROOT/utils.php';
            \$r = verifyAuditChain();
            echo \$r['valid'] ? '审计日志哈希链校验通过 ('.\$r['count'].' 条)' : '校验失败！断裂于第 '.\$r['broken_at'].' 条';
        "
        ;;

    audit-report)
        # 每日审计报告（v2.8.0 同次更新）：log-verify 结果经 sendAlert 走 SMTP 直连发送给 admin_email，
        # 无 SMTP 配置时兜底 ym-alert(mail)，失败落盘 alert.log——不再依赖 cron | mail（无 MTA 静默失败）
        php -r "
            require_once '$WEB_ROOT/utils.php';
            \$r = verifyAuditChain();
            \$result = \$r['valid'] ? '审计日志哈希链校验通过 ('.\$r['count'].' 条)' : '校验失败！断裂于第 '.\$r['broken_at'].' 条';
            echo \$result . PHP_EOL;
            sendAlert('每日审计报告', \$result);
        "
        ;;

    challenge)
        CODE=$(openssl rand -hex 3)
        EXPIRES=$(date -d "+300 seconds" +%s 2>/dev/null || echo $(($(date +%s) + 300)))
        php -r "require_once '$WEB_ROOT/utils.php'; addChallenge('$CODE', $EXPIRES);" 2>/dev/null
        echo "挑战码: $CODE (300秒有效)"
        ;;

    apply-update)
        REQUEST_FILE="/tmp/ym-update-request.json"
        if [ ! -f "$REQUEST_FILE" ]; then
            echo "错误：未找到更新请求文件"
            echo "请先在后台管理页面触发更新。"
            exit 1
        fi

        echo "=== You Super Markdown 系统更新 ==="
        echo ""

        STATUS=$(php -r "\$r = json_decode(file_get_contents('$REQUEST_FILE'), true); echo \$r['status'] ?? 'pending';")
        if [ "$STATUS" != "pending" ]; then
            echo "错误：更新请求状态异常 ($STATUS)"
            exit 1
        fi

        # 失败处理统一出口：写 failed 状态 + 重锁母本 + 清理更新锁 + 重启守护
        mark_failed() {
            local reason="$1"
            php -r "
                \$f = '$REQUEST_FILE';
                if (file_exists(\$f)) {
                    \$r = json_decode(file_get_contents(\$f), true);
                    \$r['status'] = 'failed';
                    \$r['error'] = '$reason';
                    \$r['completed_at'] = time();
                    file_put_contents(\$f, json_encode(\$r, JSON_UNESCAPED_UNICODE|JSON_PRETTY_PRINT), LOCK_EX);
                }
            " 2>/dev/null
            chattr -R +i /opt/you-markdown/install-base/ 2>/dev/null || true
            rm -f /tmp/ym-update.lock
            systemctl start ym-guard 2>/dev/null || true
        }

        FROM_VER=$(php -r "\$r = json_decode(file_get_contents('$REQUEST_FILE'), true); echo \$r['from_version'] ?? '';")
        TO_VER=$(php -r "\$r = json_decode(file_get_contents('$REQUEST_FILE'), true); echo \$r['to_version'] ?? '';")
        CHANNEL=$(php -r "\$r = json_decode(file_get_contents('$REQUEST_FILE'), true); echo \$r['channel'] ?? 'stable';")
        PKG_PATH=$(php -r "\$r = json_decode(file_get_contents('$REQUEST_FILE'), true); echo \$r['package_path'] ?? '';")

        echo "  当前版本: v$FROM_VER"
        echo "  目标版本: v$TO_VER"
        echo "  更新通道: $CHANNEL"
        echo ""

        # 防注入：目标版本仅允许数字与点（避免 preg_replace 写入 utils.php 时破坏/注入代码）
        if ! [[ "$TO_VER" =~ ^[0-9.]+$ ]]; then
            echo "错误：目标版本格式非法，已中止"
            mark_failed "目标版本格式非法"
            exit 1
        fi

        # 标记进行中
        php -r "
            \$r = json_decode(file_get_contents('$REQUEST_FILE'), true);
            \$r['status'] = 'in_progress';
            \$r['started_at'] = time();
            file_put_contents('$REQUEST_FILE', json_encode(\$r, JSON_UNESCAPED_UNICODE|JSON_PRETTY_PRINT), LOCK_EX);
        "

        # 1. 备份
        echo "[1/6] 创建备份..."
        BACKUP_DIR="/opt/you-markdown/backups"
        mkdir -p "$BACKUP_DIR"
        BACKUP_FILE="$BACKUP_DIR/pre-update-v${FROM_VER}-$(date +%s).tar.gz"
        tar -czf "$BACKUP_FILE" -C "$WEB_ROOT" --exclude='data' --exclude='.git' . 2>/dev/null
        echo "  备份: $BACKUP_FILE"

        # 2. 停守护
        echo "[2/6] 停止守护进程..."
        systemctl stop ym-guard 2>/dev/null || true
        sleep 1

        # 3. 解锁母本
        echo "[3/6] 解锁母本目录..."
        chattr -R -i /opt/you-markdown/install-base/ 2>/dev/null || true

        # 4. 应用更新
        echo "[4/6] 应用更新文件..."
        STAGE_DIR=""
        TMP_DIR=""
        PKG_TYPE="full"
        if [ -n "$PKG_PATH" ] && [ -f "$PKG_PATH" ]; then
            echo "  使用上传的更新包: $PKG_PATH"
            TMP_DIR=$(mktemp -d)
            tar -xzf "$PKG_PATH" -C "$TMP_DIR" 2>/dev/null
            if [ $? -ne 0 ]; then
                echo "  解压失败，尝试 unzip..."
                unzip -o "$PKG_PATH" -d "$TMP_DIR" 2>/dev/null || {
                    echo "错误：无法解压更新包"
                    rm -rf "$TMP_DIR"
                    mark_failed "无法解压更新包"
                    exit 1
                }
            fi
            # 定位包含核心文件的目录（兼容带顶层目录的更新包）
            if [ -f "$TMP_DIR/index.php" ] || [ -f "$TMP_DIR/utils.php" ]; then
                STAGE_DIR="$TMP_DIR"
            else
                INNER=$(find "$TMP_DIR" -mindepth 1 -maxdepth 2 \( -name index.php -o -name utils.php \) 2>/dev/null | head -1)
                if [ -n "$INNER" ]; then
                    STAGE_DIR=$(dirname "$INNER")
                fi
            fi
            # 增量包识别：无核心文件但带 version.json 且 type=incremental
            if [ -z "$STAGE_DIR" ]; then
                VFILE=$(find "$TMP_DIR" -maxdepth 3 -name version.json 2>/dev/null | head -1)
                if [ -n "$VFILE" ]; then
                    PTYPE=$(php -r "\$v = json_decode(@file_get_contents('$VFILE'), true); echo \$v['type'] ?? '';" 2>/dev/null)
                    if [ "$PTYPE" = "incremental" ]; then
                        PKG_TYPE="incremental"
                        STAGE_DIR=$(dirname "$VFILE")
                    fi
                fi
            fi
        else
            REPO_URL=$(php -r "\$c = json_decode(@file_get_contents('$WEB_ROOT/app-config.json'), true); echo \$c['repo_url'] ?? '';" 2>/dev/null)
            if [ -z "$REPO_URL" ]; then
                echo "错误：未配置仓库地址（app-config.json 的 repo_url 为空）"
                systemctl start ym-guard 2>/dev/null || true
                exit 1
            fi
            echo "  从仓库下载更新包..."
            DOWNLOAD_URL="${REPO_URL%/}/archive/refs/tags/v${TO_VER}.tar.gz"
            PKG_FILE="/tmp/ym-update-download.tar.gz"
            HTTP_CODE=$(curl -sL -o "$PKG_FILE" -w '%{http_code}' "$DOWNLOAD_URL" 2>/dev/null)
            if [ "$HTTP_CODE" != "200" ] || [ ! -s "$PKG_FILE" ]; then
                echo "错误：下载失败 (HTTP ${HTTP_CODE:-无响应})"
                rm -f "$PKG_FILE"
                mark_failed "下载失败 (HTTP ${HTTP_CODE:-无响应})"
                exit 1
            fi
            TMP_DIR=$(mktemp -d)
            tar -xzf "$PKG_FILE" -C "$TMP_DIR" 2>/dev/null || {
                echo "错误：更新包解压失败"
                rm -rf "$TMP_DIR" "$PKG_FILE"
                mark_failed "更新包解压失败"
                exit 1
            }
            # 定位包含核心文件的顶层目录
            SRC_DIR=$(find "$TMP_DIR" -mindepth 1 -maxdepth 2 \( -name index.php -o -name utils.php \) -exec dirname {} \; 2>/dev/null | head -1)
            if [ -n "$SRC_DIR" ]; then
                STAGE_DIR="$SRC_DIR"
            fi
        fi
        # 双保险：全量包必须含核心文件；增量包必须含 version.json（绝不使用 --delete 清空目标）
        if [ -z "$STAGE_DIR" ]; then
            echo "错误：更新源无效（未找到核心文件或增量清单），已中止，未修改任何文件"
            rm -rf "$TMP_DIR" "${PKG_FILE:-}" 2>/dev/null || true
            mark_failed "更新源无效（未找到核心文件或增量清单）"
            exit 1
        fi
        if [ "$PKG_TYPE" = "incremental" ]; then
            if [ ! -f "$STAGE_DIR/version.json" ]; then
                echo "错误：增量包缺少 version.json，已中止，未修改任何文件"
                rm -rf "$TMP_DIR" "${PKG_FILE:-}" 2>/dev/null || true
                mark_failed "增量包缺少 version.json"
                exit 1
            fi
            echo "  增量更新：仅覆盖变更文件，不删除现有文件"
            rsync -a --exclude='data/' --exclude='version.json' "$STAGE_DIR/" "$WEB_ROOT/" 2>/dev/null
            rsync -a --exclude='data/' --exclude='version.json' "$STAGE_DIR/" "/opt/you-markdown/install-base/" 2>/dev/null
        else
            if [ ! -f "$STAGE_DIR/index.php" ] && [ ! -f "$STAGE_DIR/utils.php" ]; then
                echo "错误：全量更新源无效（缺少 index.php/utils.php），已中止，未修改任何文件"
                rm -rf "$TMP_DIR" "${PKG_FILE:-}" 2>/dev/null || true
                mark_failed "全量更新源无效（缺少核心文件）"
                exit 1
            fi
            rsync -a --delete --exclude='data/' "$STAGE_DIR/" "$WEB_ROOT/" 2>/dev/null
            rsync -a --delete --exclude='data/' "$STAGE_DIR/" "/opt/you-markdown/install-base/" 2>/dev/null
        fi
        rm -rf "$TMP_DIR" 2>/dev/null || true
        echo "  文件更新完成"

        # 4.4 同步运行中的守护进程与 CLI（安装时复制到 /opt 与 /usr/local/bin，更新时需一并覆盖）
        if [ -f "$WEB_ROOT/ym-guard.py" ]; then
            cp "$WEB_ROOT/ym-guard.py" /opt/you-markdown/ym-guard.py 2>/dev/null || true
            chmod 700 /opt/you-markdown/ym-guard.py 2>/dev/null || true
        fi
        if [ -f "$WEB_ROOT/ym-admin" ]; then
            cp "$WEB_ROOT/ym-admin" /usr/local/bin/ym-admin 2>/dev/null || true
            chmod +x /usr/local/bin/ym-admin 2>/dev/null || true
        fi

        # 4.5 JSON → SQLite 迁移（v2.5.0；幂等，有标记则跳过）
        if [ -f "$WEB_ROOT/ym-migrate" ]; then
            php "$WEB_ROOT/ym-migrate" 2>&1 || {
                echo "错误：数据迁移失败，已中止"
                rm -rf "$TMP_DIR" 2>/dev/null || true
                mark_failed "数据迁移失败"
                exit 1
            }
            # 确保 PHP-FPM（www-data）可写 SQLite 及 WAL/SHM 文件；data 目录组可写供 CLI 只读命令无 sudo 读取
            chown -R www-data:www-data "$WEB_ROOT/data" 2>/dev/null || true
            chmod 775 "$WEB_ROOT/data" 2>/dev/null || true
            chmod 660 "$WEB_ROOT/data/ym.db" 2>/dev/null || true
            echo "  数据迁移完成"
        fi

        # 5. 锁定母本
        echo "[5/6] 锁定母本目录..."
        chattr -R +i /opt/you-markdown/install-base/ 2>/dev/null || true

        # 6. 重启守护
        echo "[6/6] 重启守护进程并记录日志..."
        php -r "
            \$cfgFile = '$WEB_ROOT/app-config.json';
            if (file_exists(\$cfgFile)) {
                \$c = json_decode(file_get_contents(\$cfgFile), true) ?: [];
                \$c['version'] = '$TO_VER';
                file_put_contents(\$cfgFile, json_encode(\$c, JSON_UNESCAPED_UNICODE|JSON_PRETTY_PRINT), LOCK_EX);
                @copy(\$cfgFile, '/opt/you-markdown/install-base/app-config.json');
            }
        " 2>/dev/null
        php -r "
            require_once '$WEB_ROOT/utils.php';
            auditLog('system_update', '', '系统更新: v${FROM_VER} → v${TO_VER}');
        " 2>/dev/null
        systemctl start ym-guard 2>/dev/null || true
        rm -f /tmp/ym-update.lock
        php -r "
            \$r = json_decode(file_get_contents('$REQUEST_FILE'), true);
            \$r['status'] = 'completed';
            \$r['completed_at'] = time();
            file_put_contents('$REQUEST_FILE', json_encode(\$r, JSON_UNESCAPED_UNICODE|JSON_PRETTY_PRINT), LOCK_EX);
        "

        # 清理旧备份（保留最近2次）
        echo "  清理旧备份..."
        ls -t "$BACKUP_DIR"/pre-update-*.tar.gz 2>/dev/null | tail -n +3 | xargs rm -f 2>/dev/null || true

        echo ""
        echo "============================================"
        echo "  更新完成！"
        echo "  版本: v$FROM_VER → v$TO_VER"
        echo "============================================"
        ;;

    rollback)
        BACKUP_DIR="/opt/you-markdown/backups"
        if [ ! -d "$BACKUP_DIR" ] || [ -z "$(ls -A "$BACKUP_DIR"/pre-update-*.tar.gz 2>/dev/null)" ]; then
            echo "错误：没有可用的备份"
            exit 1
        fi

        echo "=== 可用备份 ==="
        echo ""
        I=1
        for B in $(ls -t "$BACKUP_DIR"/pre-update-*.tar.gz 2>/dev/null); do
            BASENAME=$(basename "$B")
            SIZE=$(du -h "$B" | cut -f1)
            if [[ $BASENAME =~ pre-update-v([0-9.]+)-([0-9]+)\.tar\.gz ]]; then
                VER="${BASH_REMATCH[1]}"
                TS=$(date -d @"${BASH_REMATCH[2]}" '+%Y-%m-%d %H:%M:%S' 2>/dev/null || echo "unknown")
                echo "  [$I] v$VER ($TS) - $SIZE"
            else
                echo "  [$I] $BASENAME - $SIZE"
            fi
            I=$((I+1))
        done
        echo ""
        echo "要回滚到哪个备份？(输入编号)"
        read -r CHOICE
        SELECTED=$(ls -t "$BACKUP_DIR"/pre-update-*.tar.gz 2>/dev/null | sed -n "${CHOICE}p")
        if [ -z "$SELECTED" ]; then
            echo "错误：无效选择"
            exit 1
        fi

        echo ""
        echo "正在回滚到: $(basename "$SELECTED")"
        echo ""

        echo "[1/3] 停止守护进程..."
        systemctl stop ym-guard 2>/dev/null || true
        sleep 1

        # 解锁母本，恢复完成后重新锁定（避免 +i 只读导致 rsync 失败/母本与 web 不一致）
        chattr -R -i /opt/you-markdown/install-base/ 2>/dev/null || true

        echo "[2/3] 恢复文件..."
        tar -xzf "$SELECTED" -C "$WEB_ROOT" 2>/dev/null
        rsync -a --delete --exclude='data/' "$WEB_ROOT/" "/opt/you-markdown/install-base/" 2>/dev/null
        chattr -R +i /opt/you-markdown/install-base/ 2>/dev/null || true
        echo "  文件恢复完成"

        echo "[3/3] 重启守护进程..."
        systemctl start ym-guard 2>/dev/null || true
        rm -f /tmp/ym-update.lock

        echo ""
        echo "============================================"
        echo "  回滚完成！"
        echo "============================================"
        ;;

    hfish-panel)
        PORTS_FILE="/opt/you-markdown/hfish-ports.conf"
        if [ ! -f "$PORTS_FILE" ]; then
            echo "Hfish 未安装或配置文件不存在"
            exit 1
        fi
        source "$PORTS_FILE"
        PANEL_PORT="${HFISH_PANEL_PORT:-4433}"
        echo ""
        echo "============================================"
        echo "  Hfish 管理面板隧道已建立"
        echo "============================================"
        echo ""
        echo "  本地访问地址: http://127.0.0.1:${PANEL_PORT}"
        echo ""
        echo "  请在本地浏览器中打开上述地址"
        echo "  按 Ctrl+C 关闭隧道"
        echo "============================================"
        echo ""
        ssh -L "${PANEL_PORT}:127.0.0.1:${PANEL_PORT}" -N root@127.0.0.1
        ;;

    hfish-status)
        echo "=== Hfish 蜜罐状态 ==="
        echo ""
        PORTS_FILE="/opt/you-markdown/hfish-ports.conf"
        if [ -f "$PORTS_FILE" ]; then
            source "$PORTS_FILE"
            echo "配置端口:"
            echo "  管理面板: ${HFISH_PANEL_PORT:-4433}"
            echo "  节点通信: ${HFISH_NODE_PORT:-4434}"
            echo "  蜜獾账户: ${HFISH_USER:-xiao}"
        else
            echo "  端口配置文件不存在"
        fi
        echo ""
        echo "服务状态:"
        if systemctl is-active --quiet hfish 2>/dev/null; then
            echo "  hfish.service: 运行中"
        else
            echo "  hfish.service: 未运行"
        fi
        ;;

    *)
        echo "You Super Markdown CLI 管理工具"
        echo ""
        echo "用法: ym-admin <命令> [参数]"
        echo ""
        echo "命令:"
        echo "  login                    生成 OTP 管理入口"
        echo "  create-station <名称>     创建站长账号"
        echo "  create-author <名称>      创建写作者账号"
        echo "  revoke-user <用户ID>      吊销用户"
        echo "  backup                    备份数据"
        echo "  status                    查看服务状态"
        echo "  log-verify                校验审计日志哈希链"
        echo "  audit-report              每日审计报告（校验结果经 SMTP 发送给管理员）"
        echo "  challenge                 生成挑战码"
        echo "  apply-update              执行系统更新"
        echo "  rollback                  回滚到备份版本"
        echo "  hfish-panel               建立 SSH 隧道访问 Hfish 管理面板"
        echo "  hfish-status              查看 Hfish 蜜罐状态"
        echo ""
        echo "环境变量:"
        echo "  YM_WEB_ROOT               Web 根目录 (默认 /var/www/you-markdown)"
        ;;
esac