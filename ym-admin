#!/bin/bash
WEB_ROOT="${YM_WEB_ROOT:-/var/www/you-markdown}"
ENTRIES_FILE="$WEB_ROOT/data/.entries.json"
USERS_FILE="$WEB_ROOT/data/.users.json"

# 自动获取站点域名（v2.10.2 修复：禁止硬编码域名——优先 app-config.json 的 site_url，否则从 Nginx server_name 解析）
# v2.11.2：剥离 scheme 与路径（site_url 可能带 https://，避免拼接出 https://https:// 双前缀）
get_domain() {
    local d
    d=$(php -r "\$c=json_decode(@file_get_contents('$WEB_ROOT/app-config.json'),true); echo trim((string)(\$c['site_url']??''));" 2>/dev/null)
    d=${d#http://}
    d=${d#https://}
    d=${d%%/*}
    if [ -z "$d" ]; then
        d=$(grep -rhoP 'server_name\s+\K[^;]+' /etc/nginx/sites-enabled/ /etc/nginx/conf.d/ 2>/dev/null | grep -v '^_' | head -1 | awk '{print $1}')
    fi
    [ -z "$d" ] && d="localhost"
    echo "$d"
}

# v3.1.0：更新完成收尾（必须定义为顶部函数——apply-update 会覆盖 /usr/local/bin/ym-admin 自身，
# bash 惰性解析时仅对已读入内存的函数体免疫「新旧文件混合」语法错误，case 内联代码会在覆盖后解析失败）
# v3.1.7：新增第 4 参 CHANGELOG_B64——更新通知邮件自动附带本次更新内容（changelog 脱敏文案）
# v3.1.15：新增第 5 参 UPDATE_METHOD——邮件附带更新方式（外部上传更新包 / 服务器命令更新）
post_update_finish() {
    local TO_VER="$1" CHANNEL="$2" FROM_VER="$3" CHANGELOG_B64="$4" UPDATE_METHOD="$5"
    # 请求文件 root 可删，避免以 php 回写时 /tmp 属主权限拒绝
    rm -f /tmp/ym-update-request.json
    # 清理旧备份（保留最近2次）
    echo "  清理旧备份..."
    ls -t "/opt/you-markdown/backups"/pre-update-*.tar.gz 2>/dev/null | tail -n +3 | xargs rm -f 2>/dev/null || true
    echo ""
    echo "============================================"
    echo "  更新完成！"
    echo "  版本: v$FROM_VER → v$TO_VER"
    echo "============================================"
    # v3.1.0：更新完成自动发送通知邮件到管理员（失败不阻断）
    # v3.1.7：邮件正文附带本次更新内容（changelog），管理者无需再翻公告即可知道本次改了什么
    NOTIFY_MSG="系统已更新至 v$TO_VER（$CHANNEL 更新通道）—— 更新完成，web↔母本 MD5 一致、守护进程正常运行。"
    if [ -n "$CHANGELOG_B64" ]; then
        CL_TEXT=$(printf '%s' "$CHANGELOG_B64" | base64 -d 2>/dev/null)
        if [ -n "$CL_TEXT" ]; then
            NOTIFY_MSG="$NOTIFY_MSG

【本次更新内容】
$CL_TEXT"
        fi
    fi
    # v3.1.15：邮件附带本次更新方式（区分后台外部上传更新包 / 服务器命令触发仓库下载更新）
    if [ -n "$UPDATE_METHOD" ]; then
        NOTIFY_MSG="$NOTIFY_MSG

【更新方式】$UPDATE_METHOD"
    fi
    /usr/local/bin/ym-admin notify "$NOTIFY_MSG" 2>/dev/null || true
}

# v3.2.0：更新包签名验证（RSA 非对称）——服务器内置公钥 /opt/you-markdown/update_signing_public.pem，
# 正式更新包在包根内置 manifest.json（全文件 SHA256）+ manifest.json.sig（私钥签名）。
# 返回 0 通过；非 0 失败（失败封闭）。未部署公钥 → 跳过验证（旧环境兼容）。
verify_package_signature() {
    local tmp_root="$1"
    local pubkey="/opt/you-markdown/update_signing_public.pem"
    local mf sig bad root
    if [ ! -f "$pubkey" ]; then
        echo "  [签名] 未部署公钥，跳过签名验证（旧环境兼容）"
        return 0
    fi
    mf=$(find "$tmp_root" -maxdepth 3 -name manifest.json 2>/dev/null | head -1)
    if [ -z "$mf" ] || [ ! -f "$mf" ]; then
        echo "  [签名] 错误：已部署公钥但更新包缺少 manifest.json，拒绝更新（失败封闭）"
        return 1
    fi
    sig="$mf.sig"
    if [ ! -f "$sig" ]; then
        echo "  [签名] 错误：已部署公钥但更新包缺少签名文件 manifest.json.sig，拒绝更新（失败封闭）"
        return 1
    fi
    if ! openssl dgst -sha256 -verify "$pubkey" -signature "$sig" "$mf" >/dev/null 2>&1; then
        echo "  [签名] 错误：manifest 签名验证失败，包可能被篡改，拒绝更新"
        return 1
    fi
    echo "  [签名] manifest 签名验证通过"
    # 逐文件 SHA256 与 manifest 比对（manifest.json / manifest.json.sig 自身不校验）
    root=$(dirname "$mf")
    bad=$(php -r "
        \$mf = '$mf';
        \$root = '$root';
        \$m = json_decode(@file_get_contents(\$mf), true);
        \$files = \$m['files'] ?? [];
        foreach (\$files as \$rel => \$expect) {
            \$p = rtrim(\$root, '/') . '/' . ltrim(\$rel, '/');
            if (!is_file(\$p)) { echo \"missing:\$rel\n\"; continue; }
            if (hash_file('sha256', \$p) !== \$expect) { echo \"mismatch:\$rel\n\"; }
        }
    " 2>/dev/null)
    if [ -n "$bad" ]; then
        echo "  [签名] 错误：文件哈希校验失败："
        echo "$bad" | head -5
        return 1
    fi
    echo "  [签名] 全部文件哈希校验通过"
    return 0
}

# v3.2.0：更新失败自动回退——从最新备份恢复 WEB_ROOT 与母本（停守护→解锁→恢复→锁定→重启）
# v3.2.0-fix：回退完成自动向管理员发送通知邮件（$1 = 失败原因）
auto_rollback() {
    local reason="${1:-}"
    local BACKUP_DIR="/opt/you-markdown/backups"
    local LATEST
    LATEST=$(ls -t "$BACKUP_DIR"/pre-update-*.tar.gz 2>/dev/null | head -1)
    if [ -z "$LATEST" ]; then
        echo "  [回退] 错误：没有可用备份，无法自动回退，请人工介入"
        return 1
    fi
    echo "  [回退] 检测到更新失败，自动回退到备份: $(basename "$LATEST")"
    systemctl stop ym-guard 2>/dev/null || true
    sleep 1
    chattr -R -i /opt/you-markdown/install-base/ 2>/dev/null || true
    tar -xzf "$LATEST" -C "$WEB_ROOT" 2>/dev/null
    rsync -a --delete --exclude='data/' "$WEB_ROOT/" "/opt/you-markdown/install-base/" 2>/dev/null
    chattr -R +i /opt/you-markdown/install-base/ 2>/dev/null || true
    systemctl start ym-guard 2>/dev/null || true
    rm -f /tmp/ym-update.lock
    echo "  [回退] 自动回退完成，系统已恢复至更新前状态"
    # 回退完成自动通知管理员（失败不阻断）
    /usr/local/bin/ym-admin notify "系统更新失败，已自动回退并恢复正常。${reason:+失败原因：${reason}。}系统已恢复至更新前状态，请登录后台查看更新状态。" 2>/dev/null || true
    return 0
}

case "${1:-}" in
    login)
        ENTRY_TOKEN=$(openssl rand -base64 12 | tr -d '=+/' | cut -c1-12)
        OTP=$(openssl rand -base64 12 | tr -d '=+/' | cut -c1-12)
        OTP_HASH=$(php -r "echo password_hash('$OTP', PASSWORD_DEFAULT);")
        EXPIRES=$(( $(date +%s) + 600 ))

        php -r "require_once '$WEB_ROOT/utils.php'; addEntry('$ENTRY_TOKEN', '$OTP_HASH', $EXPIRES);" 2>/dev/null

        echo ""
        echo "============================================"
        echo "  管理入口（仅显示一次，10分钟有效）"
        echo "============================================"
        echo ""
        echo "  入口 URL: https://$(get_domain)/admin/entry/$ENTRY_TOKEN"
        echo "  一次性密码: $OTP"
        echo ""
        echo "  ⚠️ 请立即保存！"
        echo "============================================"
        echo ""
        ;;

    create-station)
        NAME="${2:-}"
        if [ -z "$NAME" ]; then echo "用法: ym-admin create-station <站长名称>"; exit 1; fi
        QQ="station_$(openssl rand -hex 4)"
        # v2.6.4：生成满足密码策略（≥8 位 + 大写 + 小写 + 数字）的随机密码
        for i in 1 2 3 4 5; do
            PWD=$(openssl rand -base64 12 | tr -d '=+/')
            if [ ${#PWD} -ge 8 ] && echo "$PWD" | grep -q '[a-z]' && echo "$PWD" | grep -q '[A-Z]' && echo "$PWD" | grep -q '[0-9]'; then
                break
            fi
        done
        php -r "
            require_once '$WEB_ROOT/utils.php';
            \$u = loadUsers();
            \$u[] = ['id'=>bin2hex(random_bytes(8)),'qq'=>'$QQ','nickname'=>'$NAME','password'=>password_hash('$PWD',PASSWORD_DEFAULT),'role'=>'station_admin','created'=>date('Y-m-d H:i:s')];
            saveUsers(\$u);
        " 2>/dev/null
        echo "站长账号已创建: $NAME (QQ: $QQ, 密码: $PWD)"
        ;;

    create-author)
        NAME="${2:-}"
        STATION_ID="${3:-}"
        if [ -z "$NAME" ]; then echo "用法: ym-admin create-author <写作者名称> [站长ID]"; exit 1; fi
        QQ="author_$(openssl rand -hex 4)"
        # v2.6.4：生成满足密码策略（≥8 位 + 大写 + 小写 + 数字）的随机密码
        for i in 1 2 3 4 5; do
            PWD=$(openssl rand -base64 12 | tr -d '=+/')
            if [ ${#PWD} -ge 8 ] && echo "$PWD" | grep -q '[a-z]' && echo "$PWD" | grep -q '[A-Z]' && echo "$PWD" | grep -q '[0-9]'; then
                break
            fi
        done
        php -r "
            require_once '$WEB_ROOT/utils.php';
            \$u = loadUsers();
            \$u[] = ['id'=>bin2hex(random_bytes(8)),'qq'=>'$QQ','nickname'=>'$NAME','password'=>password_hash('$PWD',PASSWORD_DEFAULT),'role'=>'author','station_id'=>'$STATION_ID','created'=>date('Y-m-d H:i:s')];
            saveUsers(\$u);
        " 2>/dev/null
        echo "写作者账号已创建: $NAME (QQ: $QQ, 密码: $PWD)"
        ;;

    revoke-user)
        USER_ID="${2:-}"
        if [ -z "$USER_ID" ]; then echo "用法: ym-admin revoke-user <用户ID>"; exit 1; fi
        php -r "require_once '$WEB_ROOT/utils.php'; db_exec('DELETE FROM users WHERE id = ?', ['$USER_ID']);" 2>/dev/null
        echo "用户已吊销: $USER_ID"
        ;;

    backup)
        BACKUP_DIR="/opt/you-markdown/backups"
        mkdir -p "$BACKUP_DIR"
        tar -czf "$BACKUP_DIR/ym-backup-$(date +%Y%m%d-%H%M%S).tar.gz" -C "$WEB_ROOT" data/ 2>/dev/null
        echo "备份完成: $BACKUP_DIR"
        ;;

    status)
        echo "守护进程: $(systemctl is-active ym-guard 2>/dev/null || echo 'unknown')"
        echo "Nginx: $(systemctl is-active nginx 2>/dev/null || echo 'unknown')"
        PHP_FPM_SVC="php$(php -r 'echo PHP_MAJOR_VERSION.".".PHP_MINOR_VERSION;')-fpm"
        echo "PHP-FPM: $(systemctl is-active $PHP_FPM_SVC 2>/dev/null || systemctl is-active php-fpm 2>/dev/null || echo 'unknown')"
        echo "用户数: $(php -r "require_once '$WEB_ROOT/utils.php'; echo count(loadUsers());" 2>/dev/null)"
        ;;

    log-verify)
        php -r "
            require_once '$WEB_ROOT/utils.php';
            \$r = verifyAuditChain();
            echo \$r['valid'] ? '审计日志哈希链校验通过 ('.\$r['count'].' 条)' : '校验失败！断裂于第 '.\$r['broken_at'].' 条';
        "
        ;;

    audit-report)
        # 每日审计报告（v2.8.0 同次更新）：log-verify 结果经 sendAlert 走 SMTP 直连发送给 admin_email，
        # 无 SMTP 配置时兜底 ym-alert(mail)，失败落盘 alert.log——不再依赖 cron | mail（无 MTA 静默失败）
        # v3.0.9：SMTP 授权码经环境变量注入（CLI 读 root 密钥文件 /opt/you-markdown/secrets/smtp_pass）
        SMTP_PASS_FILE="/opt/you-markdown/secrets/smtp_pass"
        if [ -f "$SMTP_PASS_FILE" ]; then
            YM_SMTP_PASS="$(cat "$SMTP_PASS_FILE")" php -r "
                require_once '$WEB_ROOT/utils.php';
                \$r = verifyAuditChain();
                \$result = \$r['valid'] ? '审计日志哈希链校验通过 ('.\$r['count'].' 条)' : '校验失败！断裂于第 '.\$r['broken_at'].' 条';
                echo \$result . PHP_EOL;
                sendAlert('每日审计报告', \$result);
            "
        else
            php -r "
                require_once '$WEB_ROOT/utils.php';
                \$r = verifyAuditChain();
                \$result = \$r['valid'] ? '审计日志哈希链校验通过 ('.\$r['count'].' 条)' : '校验失败！断裂于第 '.\$r['broken_at'].' 条';
                echo \$result . PHP_EOL;
                sendAlert('每日审计报告', \$result);
            "
        fi
        ;;

    notify)
        # v3.1.0：发送通知邮件到管理员邮箱（测试/更新/运维消息均可用）
        # v3.1.1：复用 renderMailHtml 统一邮件模板（HTML 布局 + 纯文本双版本 multipart），修复纯文本无布局
        # 用法: ym-admin notify "<消息>"；CLI 发信注入 YM_SMTP_PASS（root 密钥文件）
        MSG="${2:-}"
        if [ -z "$MSG" ]; then echo "用法: ym-admin notify <消息>"; exit 1; fi
        SMTP_PASS_FILE="/opt/you-markdown/secrets/smtp_pass"
        if [ -f "$SMTP_PASS_FILE" ]; then
            YM_SMTP_PASS="$(cat "$SMTP_PASS_FILE")" MSG_B64=$(printf '%s' "$MSG" | base64 -w0 2>/dev/null || printf '%s' "$MSG" | base64) \
            php -r "
                require_once '$WEB_ROOT/utils.php';
                \$cfg = loadSiteConfig();
                \$to = \$cfg['admin_email'] ?? '';
                if (\$to === '') { echo 'NO_ADMIN_EMAIL'; exit(0); }
                \$site = \$cfg['site_title'] ?? 'You Super Markdown';
                \$msg = base64_decode(getenv('MSG_B64'));
                \$subject = '[You Super Markdown] ' . mb_substr(\$msg, 0, 60);
                \$html = renderMailHtml(\$site, '通知', \$msg, ['server' => gethostname(), 'time' => date('Y-m-d H:i:s')]);
                [\$ok, \$err] = sendSmtpMail(\$to, \$subject, \$msg, \$html);
                echo \$ok ? 'MAIL_OK' : ('MAIL_FAIL: ' . \$err);
            "
        else
            echo "NO_SMTP_SECRET"
        fi
        ;;

    challenge)
        CODE=$(openssl rand -hex 3)
        EXPIRES=$(date -d "+300 seconds" +%s 2>/dev/null || echo $(($(date +%s) + 300)))
        php -r "require_once '$WEB_ROOT/utils.php'; addChallenge('$CODE', $EXPIRES);" 2>/dev/null
        echo "挑战码: $CODE (300秒有效)"
        ;;

    apply-update)
        REQUEST_FILE="/tmp/ym-update-request.json"
        if [ ! -f "$REQUEST_FILE" ]; then
            echo "错误：未找到更新请求文件"
            echo "请先在后台管理页面触发更新。"
            exit 1
        fi

        echo "=== You Super Markdown 系统更新 ==="
        echo ""

        STATUS=$(php -r "\$r = json_decode(file_get_contents('$REQUEST_FILE'), true); echo \$r['status'] ?? 'pending';")
        if [ "$STATUS" != "pending" ]; then
            echo "错误：更新请求状态异常 ($STATUS)"
            exit 1
        fi

        # 失败处理统一出口：写 failed 状态 + 重锁母本 + 清理更新锁 + 重启守护
        # v3.2.0：备份已生成且文件已应用时自动回退（恢复 WEB_ROOT + 母本），并记录到 failed 状态
        mark_failed() {
            local reason="$1"
            if [ -n "${BACKUP_FILE:-}" ] && [ -f "$BACKUP_FILE" ] && [ -n "${FILES_APPLIED:-}" ]; then
                auto_rollback "$reason" && reason="$reason（已自动回退）"
            fi
            # v3.2.0：failed 状态写入改 rm + 重建（实测文件 inode 可能被安全防护瞬时锁定，
            # 直接 truncate/open-for-write 报 Permission denied，rm 后重建新文件即可写）
            local now_ts=$(date +%s)
            local reason_esc
            reason_esc=$(printf '%s' "$reason" | sed 's/\\/\\\\/g; s/"/\\"/g')
            rm -f "$REQUEST_FILE" 2>/dev/null || true
            printf '{"status":"failed","from_version":"%s","to_version":"%s","channel":"%s","error":"%s","completed_at":%d}\n' \
                "$FROM_VER" "$TO_VER" "$CHANNEL" "$reason_esc" "$now_ts" > "$REQUEST_FILE" 2>/dev/null || true
            chmod 666 "$REQUEST_FILE" 2>/dev/null || true
            chattr -R +i /opt/you-markdown/install-base/ 2>/dev/null || true
            rm -f /tmp/ym-update.lock
            systemctl start ym-guard 2>/dev/null || true
        }

        FROM_VER=$(php -r "\$r = json_decode(file_get_contents('$REQUEST_FILE'), true); echo \$r['from_version'] ?? '';")
        TO_VER=$(php -r "\$r = json_decode(file_get_contents('$REQUEST_FILE'), true); echo \$r['to_version'] ?? '';")
        CHANNEL=$(php -r "\$r = json_decode(file_get_contents('$REQUEST_FILE'), true); echo \$r['channel'] ?? 'stable';")
        PKG_PATH=$(php -r "\$r = json_decode(file_get_contents('$REQUEST_FILE'), true); echo \$r['package_path'] ?? '';")
        PKG_URL=$(php -r "\$r = json_decode(file_get_contents('$REQUEST_FILE'), true); echo \$r['package_url'] ?? '';")

        # v3.1.15：判定更新方式——PKG_PATH 非空且文件存在 → 后台外部上传更新包；否则 → 服务器命令更新（仓库下载）
        # v3.2.0：在线更新选中的仓库包（package_url）单独判定为「在线包更新（仓库下载）」
        if [ -n "$PKG_PATH" ] && [ -f "$PKG_PATH" ]; then
            UPDATE_METHOD="外部上传更新包"
        elif [ -n "$PKG_URL" ]; then
            UPDATE_METHOD="在线包更新（仓库下载）"
        else
            UPDATE_METHOD="服务器命令更新（仓库下载）"
        fi

        echo "  当前版本: v$FROM_VER"
        echo "  目标版本: v$TO_VER"
        echo "  更新通道: $CHANNEL"
        echo "  更新方式: $UPDATE_METHOD"
        echo ""

        # 防注入：目标版本仅允许数字与点（避免 preg_replace 写入 utils.php 时破坏/注入代码）
        if ! [[ "$TO_VER" =~ ^[0-9.]+$ ]]; then
            echo "错误：目标版本格式非法，已中止"
            mark_failed "目标版本格式非法"
            exit 1
        fi

        # 标记进行中
        php -r "
            \$r = json_decode(file_get_contents('$REQUEST_FILE'), true);
            \$r['status'] = 'in_progress';
            \$r['started_at'] = time();
            file_put_contents('$REQUEST_FILE', json_encode(\$r, JSON_UNESCAPED_UNICODE|JSON_PRETTY_PRINT), LOCK_EX);
        " 2>/dev/null

        # 1. 备份
        echo "[1/6] 创建备份..."
        BACKUP_DIR="/opt/you-markdown/backups"
        mkdir -p "$BACKUP_DIR"
        BACKUP_FILE="$BACKUP_DIR/pre-update-v${FROM_VER}-$(date +%s).tar.gz"
        tar -czf "$BACKUP_FILE" -C "$WEB_ROOT" --exclude='data' --exclude='.git' . 2>/dev/null
        echo "  备份: $BACKUP_FILE"

        # 2. 停守护
        echo "[2/6] 停止守护进程..."
        systemctl stop ym-guard 2>/dev/null || true
        sleep 1

        # 3. 解锁母本
        echo "[3/6] 解锁母本目录..."
        chattr -R -i /opt/you-markdown/install-base/ 2>/dev/null || true

        # 4. 应用更新
        echo "[4/6] 应用更新文件..."
        STAGE_DIR=""
        TMP_DIR=""
        PKG_FILE=""
        PKG_TYPE="full"
        FILES_APPLIED=""
        # v3.2.0：三种来源——后台上传包（PKG_PATH）/ 在线更新选中的仓库包（PKG_URL）/ 仓库 archive 全量（兼容）
        if [ -n "$PKG_PATH" ] && [ -f "$PKG_PATH" ]; then
            echo "  使用上传的更新包: $PKG_PATH"
            PKG_FILE="$PKG_PATH"
        elif [ -n "$PKG_URL" ]; then
            echo "  下载在线更新包（全量/增量包）..."
            PKG_FILE="/tmp/ym-update-download.tar.gz"
            HTTP_CODE=$(curl -sL -o "$PKG_FILE" -w '%{http_code}' "$PKG_URL" 2>/dev/null)
            if [ "$HTTP_CODE" != "200" ] || [ ! -s "$PKG_FILE" ]; then
                echo "错误：下载失败 (HTTP ${HTTP_CODE:-无响应})"
                rm -f "$PKG_FILE"
                mark_failed "下载失败 (HTTP ${HTTP_CODE:-无响应})"
                exit 1
            fi
        fi

        # 本地包 / 在线包统一：解压 → 定位 STAGE_DIR → 识别全量/增量 → 签名验证
        if [ -n "$PKG_FILE" ]; then
            TMP_DIR=$(mktemp -d)
            tar -xzf "$PKG_FILE" -C "$TMP_DIR" 2>/dev/null
            if [ $? -ne 0 ]; then
                echo "  解压失败，尝试 unzip..."
                unzip -o "$PKG_FILE" -d "$TMP_DIR" 2>/dev/null || {
                    echo "错误：无法解压更新包"
                    rm -rf "$TMP_DIR"
                    mark_failed "无法解压更新包"
                    exit 1
                }
            fi
            # v3.3.0-fix：增量包识别优先——只要 version.json 声明 type=incremental 即按增量包处理
            # （修复：增量包若含核心文件（utils.php/index.php 等）会被下方「含核心文件=全量包」逻辑误判，
            #   触发 rsync --delete 清空 WEB_ROOT/母本中包外文件，导致站点文件大面积丢失的严重故障）
            VFILE=$(find "$TMP_DIR" -maxdepth 3 -name version.json 2>/dev/null | head -1)
            if [ -n "$VFILE" ]; then
                PTYPE=$(php -r "\$v = json_decode(@file_get_contents('$VFILE'), true); echo \$v['type'] ?? '';" 2>/dev/null)
                if [ "$PTYPE" = "incremental" ]; then
                    PKG_TYPE="incremental"
                    STAGE_DIR=$(dirname "$VFILE")
                fi
            fi
            # 全量包定位（含核心文件的顶层/子目录；兼容带顶层目录的更新包）
            if [ -z "$STAGE_DIR" ]; then
                if [ -f "$TMP_DIR/index.php" ] || [ -f "$TMP_DIR/utils.php" ]; then
                    STAGE_DIR="$TMP_DIR"
                else
                    INNER=$(find "$TMP_DIR" -mindepth 1 -maxdepth 2 \( -name index.php -o -name utils.php \) 2>/dev/null | head -1)
                    if [ -n "$INNER" ]; then
                        STAGE_DIR=$(dirname "$INNER")
                    fi
                fi
            fi
            # v3.2.0：非对称密钥签名验证（服务器部署公钥后强制，失败封闭；未部署公钥跳过兼容旧环境）
            if [ -n "$STAGE_DIR" ]; then
                if ! verify_package_signature "$TMP_DIR"; then
                    rm -rf "$TMP_DIR"
                    mark_failed "更新包签名验证失败，已拒绝（可能被篡改）"
                    exit 1
                fi
            fi
        else
            REPO_URL=$(php -r "\$c = json_decode(@file_get_contents('$WEB_ROOT/app-config.json'), true); echo \$c['repo_url'] ?? '';" 2>/dev/null)
            if [ -z "$REPO_URL" ]; then
                echo "错误：未配置仓库地址（app-config.json 的 repo_url 为空）"
                systemctl start ym-guard 2>/dev/null || true
                exit 1
            fi
            echo "  从仓库下载更新包（archive 全量）..."
            DOWNLOAD_URL="${REPO_URL%/}/archive/refs/tags/v${TO_VER}.tar.gz"
            PKG_FILE="/tmp/ym-update-download.tar.gz"
            HTTP_CODE=$(curl -sL -o "$PKG_FILE" -w '%{http_code}' "$DOWNLOAD_URL" 2>/dev/null)
            if [ "$HTTP_CODE" != "200" ] || [ ! -s "$PKG_FILE" ]; then
                echo "错误：下载失败 (HTTP ${HTTP_CODE:-无响应})"
                rm -f "$PKG_FILE"
                mark_failed "下载失败 (HTTP ${HTTP_CODE:-无响应})"
                exit 1
            fi
            TMP_DIR=$(mktemp -d)
            tar -xzf "$PKG_FILE" -C "$TMP_DIR" 2>/dev/null || {
                echo "错误：更新包解压失败"
                rm -rf "$TMP_DIR" "$PKG_FILE"
                mark_failed "更新包解压失败"
                exit 1
            }
            # 定位包含核心文件的顶层目录
            SRC_DIR=$(find "$TMP_DIR" -mindepth 1 -maxdepth 2 \( -name index.php -o -name utils.php \) -exec dirname {} \; 2>/dev/null | head -1)
            if [ -n "$SRC_DIR" ]; then
                STAGE_DIR="$SRC_DIR"
            fi
        fi
        # 双保险：全量包必须含核心文件；增量包必须含 version.json（绝不使用 --delete 清空目标）
        if [ -z "$STAGE_DIR" ]; then
            echo "错误：更新源无效（未找到核心文件或增量清单），已中止，未修改任何文件"
            rm -rf "$TMP_DIR" "${PKG_FILE:-}" 2>/dev/null || true
            mark_failed "更新源无效（未找到核心文件或增量清单）"
            exit 1
        fi
        if [ "$PKG_TYPE" = "incremental" ]; then
            if [ ! -f "$STAGE_DIR/version.json" ]; then
                echo "错误：增量包缺少 version.json，已中止，未修改任何文件"
                rm -rf "$TMP_DIR" "${PKG_FILE:-}" 2>/dev/null || true
                mark_failed "增量包缺少 version.json"
                exit 1
            fi
            echo "  增量更新：仅覆盖变更文件，不删除现有文件"
            # v3.3.1-fix：STAGE_DIR 常为 mktemp -d（700），rsync -a 会把 WEB_ROOT/母本目录权限同步为 700
            # 导致 nginx（www-data）无法遍历目录 → 主页 403；统一先固定为 755 再同步
            chmod 755 "$STAGE_DIR" 2>/dev/null || true
            rsync -a --exclude='data/' --exclude='version.json' --exclude='manifest.json*' "$STAGE_DIR/" "$WEB_ROOT/" 2>/dev/null
            rsync -a --exclude='data/' --exclude='version.json' --exclude='manifest.json*' "$STAGE_DIR/" "/opt/you-markdown/install-base/" 2>/dev/null
        else
            if [ ! -f "$STAGE_DIR/index.php" ] && [ ! -f "$STAGE_DIR/utils.php" ]; then
                echo "错误：全量更新源无效（缺少 index.php/utils.php），已中止，未修改任何文件"
                rm -rf "$TMP_DIR" "${PKG_FILE:-}" 2>/dev/null || true
                mark_failed "全量更新源无效（缺少核心文件）"
                exit 1
            fi
            # v3.0.0：全量更新排除 app-config.json（服务器配置唯一真源，--delete 不得删除/覆盖）
            # v3.2.0：同时排除签名元数据 manifest.json*
            # v3.3.1-fix：同增量——先固定 STAGE_DIR 目录权限 755，防 rsync -a 覆盖目标目录为 700
            chmod 755 "$STAGE_DIR" 2>/dev/null || true
            rsync -a --delete --exclude='data/' --exclude='app-config.json' --exclude='manifest.json*' "$STAGE_DIR/" "$WEB_ROOT/" 2>/dev/null
            rsync -a --delete --exclude='data/' --exclude='app-config.json' --exclude='manifest.json*' "$STAGE_DIR/" "/opt/you-markdown/install-base/" 2>/dev/null
        fi
        # v3.2.0：文件已实际应用，此后失败触发自动回退（此前失败仅标记，文件未被修改）
        FILES_APPLIED="1"
        # 4.7a 提前读取更新包 changelog（v3.1.6：必须在清理 TMP_DIR 前读取，否则 version.json 已不存在；
        # base64 传参规避引号/特殊字符；无 changelog 字段 → 空，后续跳过）
        CHANGELOG_B64=$(php -r "
            \$vf = '$STAGE_DIR/version.json';
            if (!file_exists(\$vf)) { exit; }
            \$v = json_decode(@file_get_contents(\$vf), true) ?: [];
            echo base64_encode(trim((string)(\$v['changelog'] ?? '')));
        " 2>/dev/null)
        rm -rf "$TMP_DIR" 2>/dev/null || true
        echo "  文件更新完成"

        # 4.4 同步运行中的守护进程与 CLI（安装时复制到 /opt 与 /usr/local/bin，更新时需一并覆盖）
        if [ -f "$WEB_ROOT/ym-guard.py" ]; then
            cp "$WEB_ROOT/ym-guard.py" /opt/you-markdown/ym-guard.py 2>/dev/null || true
            chmod 700 /opt/you-markdown/ym-guard.py 2>/dev/null || true
        fi
        if [ -f "$WEB_ROOT/ym-admin" ]; then
            cp "$WEB_ROOT/ym-admin" /usr/local/bin/ym-admin 2>/dev/null || true
            chmod +x /usr/local/bin/ym-admin 2>/dev/null || true
        fi

        # 4.5 JSON → SQLite 迁移（v2.5.0；幂等，有标记则跳过）
        if [ -f "$WEB_ROOT/ym-migrate" ]; then
            php "$WEB_ROOT/ym-migrate" 2>&1 || {
                echo "错误：数据迁移失败，已中止"
                rm -rf "$TMP_DIR" 2>/dev/null || true
                mark_failed "数据迁移失败"
                exit 1
            }
            # 确保 PHP-FPM（www-data）可写 SQLite 及 WAL/SHM 文件；data 目录组可写供 CLI 只读命令无 sudo 读取
            chown -R www-data:www-data "$WEB_ROOT/data" 2>/dev/null || true
            chmod 775 "$WEB_ROOT/data" 2>/dev/null || true
            chmod 660 "$WEB_ROOT/data/ym.db" 2>/dev/null || true
            echo "  数据迁移完成"
        fi

        # 4.6 更新版本号到 web 并同步母本（v3.1.2：必须在 [5/6] 锁定母本前执行——
        # 否则 chattr +i 只读会导致 @copy 失败，母本 app-config.json 停留在旧版本，web↔母本 MD5 不一致）
        php -r "
            \$cfgFile = '$WEB_ROOT/app-config.json';
            if (file_exists(\$cfgFile)) {
                \$c = json_decode(file_get_contents(\$cfgFile), true) ?: [];
                \$c['version'] = '$TO_VER';
                file_put_contents(\$cfgFile, json_encode(\$c, JSON_UNESCAPED_UNICODE|JSON_PRETTY_PRINT), LOCK_EX);
                @copy(\$cfgFile, '/opt/you-markdown/install-base/app-config.json');
            }
        " 2>/dev/null

        # 4.7 更新历史注入（v3.1.9）：changelog 已在 4.7a 提前读取（TMP_DIR 已清理）。
        # 不再逐版本生成独立公告——把本次更新内容追加到「更新历史.md」文章（首页公告只保留
        # 一条指向该文章的公告，点进去即可查看全部历史版本更新）。
        # CHANGELOG_B64 为空 → 跳过；文章已含该版本 → 跳过（幂等）。
        if [ -n "$CHANGELOG_B64" ]; then
            php -r "
                require_once '$WEB_ROOT/utils.php';
                \$cl = base64_decode('$CHANGELOG_B64');
                \$toVer = '$TO_VER';
                \$artPath = '$WEB_ROOT/data/articles/更新历史.md';
                // 1) 文章不存在则创建骨架（META + 标题；v3.1.10：hidden 标记使文章不进首页列表，仅保留公告入口）
                if (!file_exists(\$artPath)) {
                    \$meta = json_encode(['title' => '更新历史', 'category' => '系统', 'tags' => '更新,版本,日志', 'author' => '系统', 'hidden' => true], JSON_UNESCAPED_UNICODE);
                    file_put_contents(\$artPath, \"<!--META \$meta -->\n\n# 更新历史\n\n> 全部版本更新记录，最新在前。\n\n\", LOCK_EX);
                }
                \$content = file_get_contents(\$artPath);
                // 2) 该版本已存在 → 跳过（幂等）
                if (strpos(\$content, \"## v{\$toVer}\") !== false) { exit; }
                // v3.2.3：更新历史段落不写日期（温馨公告只写版本号，日期由用户自行体会）
                \$section = \"## v{\$toVer}\n\n{\$cl}\n\n\";
                \$pos = strpos(\$content, '## ');
                if (\$pos === false) {
                    \$content .= \"\n{\$section}\";
                } else {
                    \$content = substr(\$content, 0, \$pos) . \$section . substr(\$content, \$pos);
                }
                file_put_contents(\$artPath, \$content, LOCK_EX);
                // 3) 清理历史逐版本 update 公告，确保首页只保留一条指向更新历史文章的公告
                db_exec(\"DELETE FROM announcement WHERE type = 'update'\");
                if (!db_one('SELECT 1 FROM announcement WHERE article = ? LIMIT 1', ['更新历史.md'])) {
                    addAnnouncement('manual', '更新历史.md', '', '更新历史', '全部版本更新记录整合于此，点击查看完整更新历史');
                }
            " 2>/dev/null
            chown www-data:www-data "$WEB_ROOT/data/articles/更新历史.md" 2>/dev/null || true
        fi

        # 5. 锁定母本
        echo "[5/6] 锁定母本目录..."
        chattr -R +i /opt/you-markdown/install-base/ 2>/dev/null || true

        # 6. 重启守护
        echo "[6/6] 重启守护进程并记录日志..."
        php -r "
            require_once '$WEB_ROOT/utils.php';
            auditLog('system_update', '', '系统更新: v${FROM_VER} → v${TO_VER}');
        " 2>/dev/null
        systemctl start ym-guard 2>/dev/null || true
        rm -f /tmp/ym-update.lock
        # v3.1.0：收尾逻辑抽到顶部函数（自更新后 case 内联代码会混合解析失败）
        # v3.1.7：把 changelog（4.7a 已读取）传给收尾函数，更新通知邮件附带本次更新内容
        # v3.1.15：把更新方式（外部上传更新包 / 服务器命令更新）传给收尾函数，邮件展示更新通道
        post_update_finish "$TO_VER" "$CHANNEL" "$FROM_VER" "$CHANGELOG_B64" "$UPDATE_METHOD"
        # 自更新已覆盖本脚本文件：立即退出，避免 bash 继续解析磁盘上的新内容导致混合语法错误
        exit 0
        ;;

    rollback)
        BACKUP_DIR="/opt/you-markdown/backups"
        if [ ! -d "$BACKUP_DIR" ] || [ -z "$(ls -A "$BACKUP_DIR"/pre-update-*.tar.gz 2>/dev/null)" ]; then
            echo "错误：没有可用的备份"
            exit 1
        fi

        echo "=== 可用备份 ==="
        echo ""
        I=1
        for B in $(ls -t "$BACKUP_DIR"/pre-update-*.tar.gz 2>/dev/null); do
            BASENAME=$(basename "$B")
            SIZE=$(du -h "$B" | cut -f1)
            if [[ $BASENAME =~ pre-update-v([0-9.]+)-([0-9]+)\.tar\.gz ]]; then
                VER="${BASH_REMATCH[1]}"
                TS=$(date -d @"${BASH_REMATCH[2]}" '+%Y-%m-%d %H:%M:%S' 2>/dev/null || echo "unknown")
                echo "  [$I] v$VER ($TS) - $SIZE"
            else
                echo "  [$I] $BASENAME - $SIZE"
            fi
            I=$((I+1))
        done
        echo ""
        echo "要回滚到哪个备份？(输入编号)"
        read -r CHOICE
        SELECTED=$(ls -t "$BACKUP_DIR"/pre-update-*.tar.gz 2>/dev/null | sed -n "${CHOICE}p")
        if [ -z "$SELECTED" ]; then
            echo "错误：无效选择"
            exit 1
        fi

        echo ""
        echo "正在回滚到: $(basename "$SELECTED")"
        echo ""

        echo "[1/3] 停止守护进程..."
        systemctl stop ym-guard 2>/dev/null || true
        sleep 1

        # 解锁母本，恢复完成后重新锁定（避免 +i 只读导致 rsync 失败/母本与 web 不一致）
        chattr -R -i /opt/you-markdown/install-base/ 2>/dev/null || true

        echo "[2/3] 恢复文件..."
        tar -xzf "$SELECTED" -C "$WEB_ROOT" 2>/dev/null
        rsync -a --delete --exclude='data/' "$WEB_ROOT/" "/opt/you-markdown/install-base/" 2>/dev/null
        chattr -R +i /opt/you-markdown/install-base/ 2>/dev/null || true
        echo "  文件恢复完成"

        echo "[3/3] 重启守护进程..."
        systemctl start ym-guard 2>/dev/null || true
        rm -f /tmp/ym-update.lock

        echo ""
        echo "============================================"
        echo "  回滚完成！"
        echo "============================================"
        ;;

    hfish-panel)
        PORTS_FILE="/opt/you-markdown/hfish-ports.conf"
        if [ ! -f "$PORTS_FILE" ]; then
            echo "Hfish 未安装或配置文件不存在"
            exit 1
        fi
        source "$PORTS_FILE"
        PANEL_PORT="${HFISH_PANEL_PORT:-4433}"
        echo ""
        echo "============================================"
        echo "  Hfish 管理面板隧道已建立"
        echo "============================================"
        echo ""
        echo "  本地访问地址: http://127.0.0.1:${PANEL_PORT}"
        echo ""
        echo "  请在本地浏览器中打开上述地址"
        echo "  按 Ctrl+C 关闭隧道"
        echo "============================================"
        echo ""
        ssh -L "${PANEL_PORT}:127.0.0.1:${PANEL_PORT}" -N root@127.0.0.1
        ;;

    hfish-status)
        echo "=== Hfish 蜜罐状态 ==="
        echo ""
        PORTS_FILE="/opt/you-markdown/hfish-ports.conf"
        if [ -f "$PORTS_FILE" ]; then
            source "$PORTS_FILE"
            echo "配置端口:"
            echo "  管理面板: ${HFISH_PANEL_PORT:-4433}"
            echo "  节点通信: ${HFISH_NODE_PORT:-4434}"
            echo "  蜜獾账户: ${HFISH_USER:-xiao}"
        else
            echo "  端口配置文件不存在"
        fi
        echo ""
        echo "服务状态:"
        if systemctl is-active --quiet hfish 2>/dev/null; then
            echo "  hfish.service: 运行中"
        else
            echo "  hfish.service: 未运行"
        fi
        ;;

    *)
        echo "You Super Markdown CLI 管理工具"
        echo ""
        echo "用法: ym-admin <命令> [参数]"
        echo ""
        echo "命令:"
        echo "  login                    生成 OTP 管理入口"
        echo "  create-station <名称>     创建站长账号"
        echo "  create-author <名称>      创建写作者账号"
        echo "  revoke-user <用户ID>      吊销用户"
        echo "  backup                    备份数据"
        echo "  status                    查看服务状态"
        echo "  log-verify                校验审计日志哈希链"
        echo "  audit-report              每日审计报告（校验结果经 SMTP 发送给管理员）"
        echo "  challenge                 生成挑战码"
        echo "  notify <消息>              发送通知邮件到管理员（测试/更新/运维消息）"
        echo "  apply-update              执行系统更新（完成后自动发通知邮件）"
        echo "  rollback                  回滚到备份版本"
        echo "  hfish-panel               建立 SSH 隧道访问 Hfish 管理面板"
        echo "  hfish-status              查看 Hfish 蜜罐状态"
        echo ""
        echo "环境变量:"
        echo "  YM_WEB_ROOT               Web 根目录 (默认 /var/www/you-markdown)"
        ;;
esac