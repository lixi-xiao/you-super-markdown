#!/bin/bash
WEB_ROOT="${YSM_WEB_ROOT:-/var/www/you-super-markdown}"

# 自动获取站点域名（v2.10.2 修复：禁止硬编码域名——优先 app-config.json 的 site_url，否则从 Nginx server_name 解析）
# v2.11.2：剥离 scheme 与路径（site_url 可能带 https://，避免拼接出 https://https:// 双前缀）
get_domain() {
    local d
    d=$(php -r "\$c=json_decode(@file_get_contents('$WEB_ROOT/app-config.json'),true); echo trim((string)(\$c['site_url']??''));" 2>/dev/null)
    d=${d#http://}
    d=${d#https://}
    d=${d%%/*}
    if [ -z "$d" ]; then
        d=$(grep -rhoP 'server_name\s+\K[^;]+' /etc/nginx/sites-enabled/ /etc/nginx/conf.d/ 2>/dev/null | grep -v '^_' | head -1 | awk '{print $1}')
    fi
    [ -z "$d" ] && d="localhost"
    echo "$d"
}

# v5.0.0-fix：更新流程补齐告警脚本 ysm-alert（消除「更新路径缺口」）。
# 背景：ysm-alert 仅在全新安装脚本 ysm-install.sh 中创建（ysm-install.sh:793-812）；经「更新流程」部署的
#       站点从未生成该脚本 → SMTP 未配置时告警回退 ysm-alert 失败，alert.log 出现大量「ysm-alert 不存在」。
# 幂等：与既有文件逐字节比对（cmp），内容一致则跳过；否则以 0755、root:root 写入，与全新安装一致。
# 内容与 ysm-install.sh:793-812 完全相同；不含任何凭据（仅调用系统 mail 命令）。
ensure_ysm_alert() {
    local tgt="/usr/local/bin/ysm-alert" tmp
    tmp=$(mktemp 2>/dev/null) || return 0
    cat > "$tmp" << 'EOF'
#!/bin/bash
TO="$1"
SUBJECT="$2"
BODY="$3"
if command -v mail >/dev/null 2>&1; then
    echo "$BODY" | mail -s "$SUBJECT" "$TO" 2>/tmp/ysm-alert.err
    RC=$?
    if [ $RC -ne 0 ]; then
        ERR=$(head -1 /tmp/ysm-alert.err 2>/dev/null)
        echo "$(date '+%Y-%m-%d %H:%M:%S') [FAIL] mail 命令失败(rc=$RC): $ERR" >> /opt/you-super-markdown/alert.log 2>/dev/null || true
    fi
    rm -f /tmp/ysm-alert.err
    exit $RC
else
    echo "$(date '+%Y-%m-%d %H:%M:%S') [FAIL] mail 命令不存在，无法发送告警" >> /opt/you-super-markdown/alert.log 2>/dev/null || true
    exit 1
fi
EOF
    if [ -f "$tgt" ] && cmp -s "$tmp" "$tgt"; then
        rm -f "$tmp"
        return 0
    fi
    if install -m 0755 -o root -g root "$tmp" "$tgt" 2>/dev/null; then
        echo "  已补齐告警脚本 ysm-alert（$tgt）"
    else
        echo "  警告：告警脚本 ysm-alert 写入失败（$tgt）"
    fi
    rm -f "$tmp"
}

# v3.1.0：更新完成收尾（必须定义为顶部函数——apply-update 会覆盖 /usr/local/bin/ysm-admin 自身，
# bash 惰性解析时仅对已读入内存的函数体免疫「新旧文件混合」语法错误，case 内联代码会在覆盖后解析失败）
# v3.1.7：新增第 4 参 CHANGELOG_B64——更新通知邮件自动附带本次更新内容（changelog 脱敏文案）
# v3.1.15：新增第 5 参 UPDATE_METHOD——邮件附带更新方式（外部上传更新包 / 在线包更新）
post_update_finish() {
    local TO_VER="$1" CHANNEL="$2" FROM_VER="$3" CHANGELOG_B64="$4" UPDATE_METHOD="$5"
    # 请求文件 root 可删，避免以 php 回写时属主权限拒绝（v5.0.0 P1-4：新共享目录 + 旧 /tmp 一并清理）
    rm -f /opt/you-super-markdown/run/ysm-update-request.json /tmp/ysm-update-request.json
    # 清理旧备份（保留最近2次）
    echo "  清理旧备份..."
    ls -t "/opt/you-super-markdown/backups"/pre-update-*.tar.gz 2>/dev/null | tail -n +3 | xargs rm -f 2>/dev/null || true
    # FIX-B：与站点备份同步清理配套数据库快照（保留最近2次），避免 pre-update-db-*.tar.gz 无界增长
    ls -t "/opt/you-super-markdown/backups"/db/pre-update-db-*.tar.gz 2>/dev/null | tail -n +3 | xargs rm -f 2>/dev/null || true
    # v5.0.0-fix：更新收尾确保告警脚本 ysm-alert 存在（幂等；修复「更新路径缺口」致告警静默失败）
    ensure_ysm_alert
    echo ""
    echo "============================================"
    echo "  更新完成！"
    echo "  版本: v$FROM_VER → v$TO_VER"
    echo "============================================"
    # v3.3.14：自更新场景（运行中的脚本被覆盖）下 [4.9/6] 自动补装可能未执行，给出一键命令兜底提示
    # v4.6.0：同时检测 ffmpeg（背景音乐转码依赖）
    if ! php -m 2>/dev/null | grep -qi '^gd$' || ! command -v ffmpeg >/dev/null 2>&1; then
        echo ""
        echo "  提示：未检测到全部功能依赖（php-gd/ffmpeg），运行 sudo ysm-admin deps 一键补装"
    fi
    # v3.1.0：更新完成自动发送通知邮件到管理员（失败不阻断）
    # v3.1.7：邮件正文附带本次更新内容（changelog），管理者无需再翻公告即可知道本次改了什么
    NOTIFY_MSG="系统已更新至 v$TO_VER（$CHANNEL 更新通道）—— 更新完成，web↔母本 MD5 一致、守护进程正常运行。"
    if [ -n "$CHANGELOG_B64" ]; then
        CL_TEXT=$(printf '%s' "$CHANGELOG_B64" | base64 -d 2>/dev/null)
        if [ -n "$CL_TEXT" ]; then
            NOTIFY_MSG="$NOTIFY_MSG

【本次更新内容】
$CL_TEXT"
        fi
    fi
    # v3.1.15：邮件附带本次更新方式（区分后台外部上传更新包 / 在线更新选中的仓库包）
    if [ -n "$UPDATE_METHOD" ]; then
        NOTIFY_MSG="$NOTIFY_MSG

【更新方式】$UPDATE_METHOD"
    fi
    /usr/local/bin/ysm-admin notify "$NOTIFY_MSG" 2>/dev/null || true
}

# ============================================================
# v4.5.0：声明式依赖清单——以后更新包新增功能要装依赖，只需在包的 version.json
# 声明 "deps": ["<包名>", ...]，走正常更新通道（apply-update [4.9/6]）即自动安装，
# 无需再改更新路径 / ysm-admin 代码。内置兜底清单兼容旧包（无 deps 字段）。
# 依赖安装失败 → 中断更新并自动回滚（保证功能完整）。
# v4.6.0：兜底清单补 ffmpeg（背景音乐转码依赖，与 ysm-install.sh 全新安装一致）
# ============================================================
REQUIRED_DEPS_FALLBACK="php-gd ffmpeg"

# 读取更新包 version.json 声明的依赖（无 deps 字段 / 旧包返回空）
pkg_declared_deps() {
    local vj="$1"
    [ -f "$vj" ] || { echo ""; return 0; }
    php -r '
        $d = json_decode(@file_get_contents($argv[1]), true);
        $deps = is_array($d) ? ($d["deps"] ?? []) : [];
        $out = [];
        foreach ((array)$deps as $x) { if (is_string($x) && trim($x) !== "") $out[] = $x; }
        echo implode(" ", $out);
    ' "$vj" 2>/dev/null
}

# 检测单个依赖是否就绪（0=已就绪）
dep_ready() {
    case "$1" in
        php-gd)  php -m 2>/dev/null | grep -qi '^gd$' ;;
        ffmpeg)  command -v ffmpeg >/dev/null 2>&1 ;;
        *)       command -v "$1" >/dev/null 2>&1 ;;
    esac
    return $?
}

# 安装单个依赖（0=成功；非 0=失败）
install_one_dep() {
    local name="$1" os_id=""
    [ -r /etc/os-release ] && os_id=$(sed -n 's/^ID=//p' /etc/os-release | tr -d '"')
    echo "  [环境] 缺少 $name，自动补装..."
    case "$name" in
        php-gd)
            case "$os_id" in
                ubuntu|debian)
                    apt-get install -y "php$(php -r 'echo PHP_MAJOR_VERSION.".".PHP_MINOR_VERSION;')-gd" >/dev/null 2>&1 \
                        || apt-get install -y php-gd >/dev/null 2>&1 \
                        || { echo "  [环境] 警告：php-gd 安装失败"; return 1; }
                    ;;
                centos|rhel|fedora|almalinux|rocky|ol)
                    yum install -y php-gd >/dev/null 2>&1 || dnf install -y php-gd >/dev/null 2>&1 \
                        || { echo "  [环境] 警告：php-gd 安装失败"; return 1; }
                    ;;
                *)
                    echo "  [环境] 未知发行版，无法自动安装 php-gd"
                    return 1
                    ;;
            esac
            # 重启 php-fpm 使扩展生效
            for f in php-fpm "php$(php -r 'echo PHP_MAJOR_VERSION.".".PHP_MINOR_VERSION;')-fpm"; do
                if systemctl list-unit-files "$f.service" 2>/dev/null | grep -q "$f"; then
                    systemctl restart "$f" 2>/dev/null || true; break
                fi
            done
            ;;
        ffmpeg)
            case "$os_id" in
                ubuntu|debian)
                    apt-get install -y ffmpeg >/dev/null 2>&1 \
                        || { echo "  [环境] 警告：ffmpeg 安装失败"; return 1; }
                    ;;
                centos|rhel|fedora|almalinux|rocky|ol)
                    yum install -y ffmpeg >/dev/null 2>&1 || dnf install -y ffmpeg >/dev/null 2>&1 \
                        || { echo "  [环境] 警告：ffmpeg 安装失败"; return 1; }
                    ;;
                *)
                    echo "  [环境] 未知发行版，无法自动安装 ffmpeg"
                    return 1
                    ;;
            esac
            ;;
        *)
            echo "  [环境] 未知依赖 $name，跳过"
            return 1
            ;;
    esac
    return 0
}

# v3.3.13/v4.5.0：环境自检与依赖补装——参数为空格分隔的依赖清单（缺省用内置兜底清单），
# 自动检测缺失项并 apt/yum 安装；任一失败返回非 0（apply-update 据此中断并回滚）。
ensure_env_deps() {
    local deps_all deps_uniq d ok=0 cache_sub cache_di
    # ① 缓存目录可写自愈（v4.8.4 起 covers + thumbs 全覆盖）：
    #    目录缺失则创建；已存在但属主非 www-data（如发布流程曾以 root 重建 data/cache/covers）则统一 chown，
    #    避免 cover.php/img.php 后台补图静默失败、池永远为空（主页卡片无封面且无日志，见踩坑 #43）。
    for cache_sub in thumbs covers; do
        cache_dir="$WEB_ROOT/data/cache/$cache_sub"
        if [ ! -d "$cache_dir" ] || [ "$(stat -c %U "$cache_dir" 2>/dev/null)" != "www-data" ]; then
            mkdir -p "$cache_dir" 2>/dev/null
            chown -R www-data:www-data "$WEB_ROOT/data/cache" 2>/dev/null
            echo "  [环境] 已修复封面/缩略图缓存目录 $cache_dir"
        fi
    done
    # ② 汇总依赖清单（参数 + 内置兜底，去重）
    deps_all="$REQUIRED_DEPS_FALLBACK $1"
    deps_uniq=""
    for d in $deps_all; do
        case " $deps_uniq " in
            *" $d "*) ;;
            *) deps_uniq="$deps_uniq $d" ;;
        esac
    done
    for d in $deps_uniq; do
        [ -z "$d" ] && continue
        if dep_ready "$d"; then
            echo "  [环境] $d 已就绪"
        else
            install_one_dep "$d" || ok=1
            if ! dep_ready "$d"; then
                echo "  [环境] $d 仍未就绪"
                ok=1
            fi
        fi
    done
    [ "$ok" -eq 0 ]
}

# v3.2.0：更新包签名验证（RSA 非对称）——服务器内置公钥 /opt/you-super-markdown/update_signing_public.pem，
# 正式更新包在包根内置 manifest.json（全文件 SHA256）+ manifest.json.sig（私钥签名）。
# v5.0.0：失败封闭——未部署公钥一律拒绝更新；仅当显式传入 --allow-unsigned（一次性受控引导，
# 供首包上线的无签名场景）时放行并写审计日志，不作为常规更新通道。
verify_package_signature() {
    local tmp_root="$1"
    local stage_dir="${2:-}"
    local pubkey="/opt/you-super-markdown/update_signing_public.pem"
    local mf sig bad root php_rc
    if [ ! -f "$pubkey" ]; then
        if [ "${ALLOW_UNSIGNED:-0}" = "1" ]; then
            echo "  [签名] 警告：未部署公钥，因显式 --allow-unsigned 引导开关而放行（已写审计日志）"
            php -r "require_once '$WEB_ROOT/utils.php'; auditLog('update_unsigned_allowed', 'update', '未部署签名公钥，凭 --allow-unsigned 引导开关放行更新包（一次性受控引导）');" 2>/dev/null || true
            return 0
        fi
        echo "  [签名] 错误：未部署签名公钥 $pubkey，拒绝更新（失败封闭）"
        echo "        如确为首包上线的受控引导，请显式执行：sudo ysm-admin apply-update --allow-unsigned"
        return 1
    fi
    mf=$(find "$tmp_root" -maxdepth 3 -name manifest.json 2>/dev/null | head -1)
    if [ -z "$mf" ] || [ ! -f "$mf" ]; then
        echo "  [签名] 错误：已部署公钥但更新包缺少 manifest.json，拒绝更新（失败封闭）"
        return 1
    fi
    sig="$mf.sig"
    if [ ! -f "$sig" ]; then
        echo "  [签名] 错误：已部署公钥但更新包缺少签名文件 manifest.json.sig，拒绝更新（失败封闭）"
        return 1
    fi
    if ! openssl dgst -sha256 -verify "$pubkey" -signature "$sig" "$mf" >/dev/null 2>&1; then
        echo "  [签名] 错误：manifest 签名验证失败，包可能被篡改，拒绝更新"
        return 1
    fi
    echo "  [签名] manifest 签名验证通过"
    # v5.0.0 P0-3：验签对象与落地内容强绑定——manifest.json 必须与 STAGE_DIR 同目录
    # （否则 manifest 可置于 tmp 顶层、实际落地文件来自其它子目录，签名形同虚设）
    root=$(dirname "$mf")
    if [ -n "$stage_dir" ] && [ "$root" != "$stage_dir" ]; then
        echo "  [签名] 错误：manifest.json 不在更新落地目录（$root ≠ $stage_dir），拒绝更新"
        return 1
    fi
    # 逐文件 SHA256 与 manifest 比对（manifest.json / manifest.json.sig 自身不校验）
    # v5.0.0 P0-3：文件集合完整性——STAGE_DIR 内不得存在 manifest 未列出的多余文件（防夹带未签名文件）
    # v5.0.0 第6轮 C1/H2：manifest/落地目录路径经环境变量传入，PHP 侧 getenv() 取值——
    # 杜绝把「包内容派生」的路径插值进 php -r 代码字符串（原 $mf/$root 插值可被恶意包目录名注入 RCE）
    bad=$(YSM_MF="$mf" YSM_ROOT="$root" php -r '
        $mf = getenv("YSM_MF");
        $root = getenv("YSM_ROOT");
        $m = json_decode(@file_get_contents($mf), true);
        $files = $m["files"] ?? [];
        $listed = [];
        foreach ($files as $rel => $expect) {
            $rel = ltrim($rel, "/");
            $listed[$rel] = true;
            $p = rtrim($root, "/") . "/" . $rel;
            if (!is_file($p)) { echo "missing:$rel\n"; continue; }
            if (hash_file("sha256", $p) !== $expect) { echo "mismatch:$rel\n"; }
        }
        $base = rtrim($root, "/") . "/";
        $it = new RecursiveIteratorIterator(new RecursiveDirectoryIterator(rtrim($root, "/"), FilesystemIterator::SKIP_DOTS));
        foreach ($it as $f) {
            $rel = ltrim(substr($f->getPathname(), strlen($base)), "/");
            if ($rel === "manifest.json" || $rel === "manifest.json.sig") continue;
            // v5.0.0：符号链接一律拒绝——防用软链文件/软链目录夹带未签名内容（isLink 须先于 isFile，
            // 因 isFile() 会跟随软链、软链目录默认不被递归遍历而漏检）
            if ($f->isLink()) { echo "extra:$rel\n"; continue; }
            if (!$f->isFile()) continue;
            if (!isset($listed[$rel])) { echo "extra:$rel\n"; }
        }
    ' 2>&1)
    php_rc=$?
    # v5.0.0：失败封闭——PHP 校验命令非 0 退出（如转义/引号致解析错误被吞）一律拒绝更新，
    # 不得因校验被跳过而静默放行
    if [ "$php_rc" -ne 0 ]; then
        echo "  [签名] 错误：文件校验命令执行失败（exit $php_rc），拒绝更新（失败封闭）"
        printf '%s\n' "$bad" | head -5
        return 1
    fi
    # v5.0.0：输出行必须为 missing:/mismatch:/extra: 之一，否则视为不可解析 → 拒绝
    if [ -n "$bad" ] && printf '%s\n' "$bad" | grep -vE '^(missing:|mismatch:|extra:)' | grep -q .; then
        echo "  [签名] 错误：文件校验输出不可解析，拒绝更新（失败封闭）"
        printf '%s\n' "$bad" | head -3
        return 1
    fi
    if [ -n "$bad" ]; then
        echo "  [签名] 错误：文件哈希/集合校验失败："
        echo "$bad" | head -5
        return 1
    fi
    echo "  [签名] 全部文件哈希与集合校验通过"
    return 0
}

# v3.2.0：更新失败自动回退——从最新备份恢复 WEB_ROOT 与母本（停守护→解锁→恢复→锁定→重启）
# v3.2.0-fix：回退完成自动向管理员发送通知邮件（$1 = 失败原因）
auto_rollback() {
    local reason="${1:-}"
    local BACKUP_DIR="/opt/you-super-markdown/backups"
    local LATEST base db_snap db_ts db_cu
    LATEST=$(ls -t "$BACKUP_DIR"/pre-update-*.tar.gz 2>/dev/null | head -1)
    if [ -z "$LATEST" ]; then
        echo "  [回退] 错误：没有可用备份，无法自动回退，请人工介入"
        return 1
    fi
    echo "  [回退] 检测到更新失败，自动回退到备份: $(basename "$LATEST")"
    # FIX-B：定位与站点备份「同版本+同时间戳」的数据库快照（backups/db/pre-update-db-v<ver>-<ts>.tar.gz）。
    # 由 apply-update [1/6] 生成；未找到则仅回退文件、不动数据目录（向后兼容旧备份）。
    db_snap=""
    base=$(basename "$LATEST")
    if [[ "$base" =~ pre-update-v([0-9.]+)-([0-9]+)\.tar\.gz ]]; then
        db_snap="$BACKUP_DIR/db/pre-update-db-v${BASH_REMATCH[1]}-${BASH_REMATCH[2]}.tar.gz"
        [ -f "$db_snap" ] || db_snap=""
    fi
    systemctl stop ysm-guard 2>/dev/null || true
    sleep 1
    chattr -R -i /opt/you-super-markdown/install-base/ 2>/dev/null || true
    tar -xzf "$LATEST" -C "$WEB_ROOT" 2>/dev/null
    rsync -a --delete --exclude='data/' "$WEB_ROOT/" "/opt/you-super-markdown/install-base/" 2>/dev/null
    # FIX-B：同步还原数据库——「迁移成功但后续步骤失败」时，若只回退代码会把库留在 5.0（代码 4.x、库 5.0）导致不一致。
    # 做法：守护已停（上方），先把当前库（5.0 形态）移开并保留为 *.failed.<ts>（供人工取证），
    # 再从更新前快照恢复（4.x 形态即 ym.db），最后修正属主为 www-data——使代码与库版本一致、可正常读写。
    if [ -n "$db_snap" ]; then
        db_ts=$(date +%s)
        for db_cur in "$WEB_ROOT/data/ym.db" "$WEB_ROOT/data/ym.db-wal" "$WEB_ROOT/data/ym.db-shm" \
                      "$WEB_ROOT/data/ysm.db" "$WEB_ROOT/data/ysm.db-wal" "$WEB_ROOT/data/ysm.db-shm"; do
            [ -e "$db_cur" ] && mv -f "$db_cur" "${db_cur}.failed.${db_ts}" 2>/dev/null
        done
        if tar -xzf "$db_snap" -C "$WEB_ROOT/data" 2>/dev/null; then
            chown www-data:www-data "$WEB_ROOT/data"/*.db* 2>/dev/null || true
            echo "  [回退] 已还原数据库快照: $(basename "$db_snap")（代码与库已同为更新前版本）"
        else
            echo "  [回退] 警告：数据库快照还原失败，请人工处理（失败库已保留为 *.failed.${db_ts}）"
        fi
    else
        echo "  [回退] 提示：未找到配套数据库快照，数据目录保持原样（未回退数据库）"
    fi
    chattr -R +i /opt/you-super-markdown/install-base/ 2>/dev/null || true
    systemctl start ysm-guard 2>/dev/null || true
    rm -f /opt/you-super-markdown/run/ysm-update.lock
    echo "  [回退] 自动回退完成，系统已恢复至更新前状态"
    # 回退完成自动通知管理员（失败不阻断）
    /usr/local/bin/ysm-admin notify "系统更新失败，已自动回退并恢复正常。${reason:+失败原因：${reason}。}系统已恢复至更新前状态，请登录后台查看更新状态。" 2>/dev/null || true
    return 0
}

# v5.0.0 第6轮 H1：解析下载 URL 并输出「钉死目标」<ip> <host> <port>（成功）/ 空（失败）。
# 关键修复——原实现用 sed 手写解析 host，与 curl 实际连接目标不一致（`#`/`?` 可致
#   「校验看到公网域名、curl 实际连内网 IP」的盲 SSRF）。现改为：
#   ① 全程用 php parse_url() 做与连接逻辑一致的解析（URL 经环境变量传入，杜绝字符串插值）；
#   ② 拒绝非 http(s)、userinfo（user@）、fragment（#）、内网/未识别主机、非法端口；
#   ③ 返回的公网 IP 供 curl --resolve 钉死连接，消除 DNS rebinding TOCTOU；
#   ④ v5.0.0 第7轮 FIX-3：PHP DNS（gethostbynamel/dns_get_record）不可用（disable_functions）/无记录时，
#      回退 getent 解析，再对解析出的 IP 做公网校验；仍失败则拒绝（fail-closed）。
resolve_dl_target() {
    local url="$1" host port ips ip
    # ① URL 解析（parse_url，与 curl 一致；此步不做 DNS）→ "host port"
    read -r host port <<< "$(YSM_DL_URL="$url" php -r '
        $u = (string)getenv("YSM_DL_URL");
        if ($u === "") { exit; }
        // 仅允许可见 ASCII（拒绝空白/控制字符/反斜杠等解析歧义）
        if (!preg_match("#^[!-~]+$#", $u)) { exit; }
        $p = parse_url($u);
        if (!is_array($p)) { exit; }
        $scheme = strtolower($p["scheme"] ?? "");
        if ($scheme !== "http" && $scheme !== "https") { exit; }
        // 拒绝 userinfo 与 fragment——二者正是「sed 解析」与「curl 解析」产生分歧的根源
        if (isset($p["user"]) || isset($p["pass"]) || isset($p["fragment"])) { exit; }
        $host = strtolower(trim((string)($p["host"] ?? ""), "[]"));
        if ($host === "") { exit; }
        if (!preg_match("#^[a-z0-9._-]+$#", $host) && filter_var($host, FILTER_VALIDATE_IP) === false) { exit; }
        // 首字符不得为 -/.（防 getent 等外部命令把 host 当作选项/畸形名）
        if ($host[0] === "-" || $host[0] === ".") { exit; }
        // 域名不得含空标签（如 a..b）
        if (filter_var($host, FILTER_VALIDATE_IP) === false) {
            foreach (explode(".", $host) as $lbl) { if ($lbl === "") { exit; } }
        }
        $port = isset($p["port"]) ? (int)$p["port"] : ($scheme === "https" ? 443 : 80);
        if ($port < 1 || $port > 65535) { exit; }
        echo $host . " " . $port;
    ' 2>/dev/null)"
    if [ -z "$host" ] || [ -z "$port" ]; then return 0; fi
    # ② 解析主机全部 IP：优先 PHP DNS；为空（disable_functions / 无 DNS / 无记录）则回退 getent
    ips=$(YSM_HOST="$host" YSM_UTILS="$WEB_ROOT/utils.php" php -r '
        require_once getenv("YSM_UTILS");
        foreach (resolveAllHostIps((string)getenv("YSM_HOST")) as $x) { echo $x . "\n"; }
    ' 2>/dev/null)
    if [ -z "$ips" ]; then
        if command -v getent >/dev/null 2>&1; then
            ips=$(getent ahosts "$host" 2>/dev/null | awk '{print $1}')
            if [ -z "$ips" ]; then ips=$(getent hosts "$host" 2>/dev/null | awk '{print $1}'); fi
        fi
    fi
    ips=$(printf '%s\n' "$ips" | awk 'NF && !seen[$0]++')
    if [ -z "$ips" ]; then return 0; fi
    # ③ 逐 IP 公网校验（isPrivateIp 不依赖 DNS）：任一内网即拒；取首个公网 IP（fail-closed）
    ip=$(YSM_IPS="$ips" YSM_UTILS="$WEB_ROOT/utils.php" php -r '
        require_once getenv("YSM_UTILS");
        $raw = trim((string)getenv("YSM_IPS"));
        if ($raw === "") { exit; }
        $out = "";
        $any = false;
        foreach (preg_split("#\s+#", $raw) as $x) {
            $x = trim($x);
            if ($x === "" || filter_var($x, FILTER_VALIDATE_IP) === false) { continue; }
            $any = true;
            if (isPrivateIp($x)) { exit; }   // 仍保持「任一内网即拒绝」的多 A/AAAA 记录防护
            if ($out === "") { $out = $x; }
        }
        if (!$any || $out === "") { exit; }
        echo $out;
    ' 2>/dev/null)
    if [ -z "$ip" ]; then return 0; fi
    echo "$ip $host $port"
}

# v5.0.0：在线更新包安全下载——逐跳跟随重定向（最多 3 跳），每一跳目标主机都必须为公网；
# 每一跳解析出公网 IP 后用 curl --resolve 把连接钉死到该 IP（防 DNS rebinding / #·? 盲 SSRF）；
# 非 http/https、跳数超限、目标内网/未识别/含歧义成分 → 失败。
# 用法: safe_download <url> <outfile>；返回 0 成功，非 0 失败
safe_download() {
    local url="$1" out="$2" hop=0 max_hops=3
    local hdr code loc base_authority target t_ip t_host t_port
    while :; do
        target=$(resolve_dl_target "$url")
        if [ -z "$target" ]; then
            echo "  [下载] 目标地址非法/内网/含歧义成分（userinfo 或 #），拒绝: $url"; return 1
        fi
        read -r t_ip t_host t_port <<< "$target"
        case "$t_ip" in *:*) t_ip="[$t_ip]";; esac       # IPv6 地址加方括号（curl --resolve 要求）
        case "$t_host" in *:*) t_host="[$t_host]";; esac # IPv6 字面量主机同理
        hdr=$(mktemp)
        code=$(curl -s -o "$out" -D "$hdr" -w '%{http_code}' -A 'YSM-Update/1.0' \
                     --proto '=http,https' --resolve "$t_host:$t_port:$t_ip" "$url" 2>/dev/null)
        case "$code" in
            200)
                rm -f "$hdr"
                [ -s "$out" ] && return 0
                return 1
                ;;
            301|302|303|307|308)
                loc=$(awk 'BEGIN{IGNORECASE=1} /^location:/{sub(/^[^:]*:[[:space:]]*/,""); sub(/\r$/,""); print; exit}' "$hdr")
                rm -f "$hdr"
                [ -z "$loc" ] && return 1
                if [ "$hop" -ge "$max_hops" ]; then echo "  [下载] 重定向次数过多，拒绝"; return 1; fi
                case "$loc" in
                    http://*|https://*) ;;
                    /*)  base_authority=$(printf '%s' "$url" | sed -E 's#^([a-zA-Z]+://[^/]+).*#\1#'); loc="${base_authority}${loc}" ;;
                    *)   loc="$(printf '%s' "$url" | sed -E 's#/[^/]*$#/')${loc}" ;;
                esac
                # 下一跳会重新经 resolve_dl_target 校验（内网/歧义成分在此被拒）
                url="$loc"; hop=$((hop+1)); continue
                ;;
            *)
                rm -f "$hdr"
                return 1
                ;;
        esac
    done
}

# v5.0.0 第7轮 FIX-1：只判定一次包类型——用 magic 字节（而非试探命令）确定唯一格式，
# 保证「校验方式」与「解压方式」同源同格式，杜绝 [未压缩tar]+[追加zip] 之类 polyglot 包
#   「校验走 tar 分支、解压回退 unzip」从而绕过成员校验。
#   gzip(1f 8b) → tgz；zip(50 4b 03 04) → zip；其余（含未压缩 tar 的 ustar/无法识别）→ 空（调用方直接拒绝）。
pkg_detect_type() {
    local pkg="$1" magic
    [ -f "$pkg" ] || { echo ""; return 0; }
    magic=$(head -c 4 "$pkg" 2>/dev/null | od -An -tx1 | tr -d ' \n')
    case "$magic" in
        1f8b*)     echo "tgz" ;;
        504b0304*) echo "zip" ;;
        *)         echo "" ;;
    esac
}

# v5.0.0：解包前成员名校验——拒绝绝对路径、含 .. 的路径穿越成员、（tar）软链/硬链成员、
# （zip）符号链接条目，以及含控制字符/危险字符（引号 反引号 ; # $ | & < > 括号 通配符 反斜杠）的成员名；
# 从源头切断「包内容派生路径 → 注入 php -r / shell」的可利用链，并防恶意包在解压阶段写到 TMP_DIR 之外。
# 通过后再解压（仅进 tmp），随后仍走签名验证。
# v5.0.0 第7轮 FIX-1：新增 $2 = pkg_detect_type 判定出的唯一格式（tgz|zip），校验严格走该格式，绝不跨格式试探。
archive_members_safe() {
    local pkg="$1" pkgfmt="$2" names n c
    case "$pkgfmt" in
        tgz)
            # tar：拒绝软链/硬链成员（首字符 l/h）——校验命令与解压命令同用 gzip 流
            if tar -tvzf "$pkg" 2>/dev/null | awk 'NF{print $1}' | grep -Eq '^[lh]'; then
                echo "  [校验] 更新包含软链/硬链成员，已拒绝"; return 1
            fi
            names=$(tar -tzf "$pkg" 2>/dev/null)
            ;;
        zip)
            # v5.0.0 第6轮 M2：zip——拒绝含符号链接的条目
            # （zipinfo -v 的 "Unix file attributes" 权限串以 l 开头即 symlink；unzip 缺失/不可解析 → names 空 → 拒绝）
            if unzip -Z -v "$pkg" 2>/dev/null | grep -Eq ':[[:space:]]+l[rwxstST-]{9}([[:space:]]|$)'; then
                echo "  [校验] 更新包 zip 含符号链接条目，已拒绝"; return 1
            fi
            names=$(unzip -Z1 "$pkg" 2>/dev/null)
            ;;
        *)
            echo "  [校验] 无法识别的更新包格式，已拒绝"; return 1
            ;;
    esac
    if [ -z "$names" ]; then
        echo "  [校验] 无法读取更新包成员列表，已拒绝"; return 1
    fi
    # 危险字符黑名单（可用于跳出 shell/PHP 单双引号字符串、或造成 glob/重定向歧义）
    local bad_chars="'\"\`;&#\$|&<>(){}[]*?\\"
    while IFS= read -r n; do
        [ -z "$n" ] && continue
        case "$n" in
            /*|..|../*|*/../*|*/..) echo "  [校验] 更新包含路径穿越成员，已拒绝: $n"; return 1 ;;
        esac
        # 控制字符（含 CR/TAB/NUL）一律拒绝
        case "$n" in
            *[[:cntrl:]]*) echo "  [校验] 更新包成员名含控制字符，已拒绝: $n"; return 1 ;;
        esac
        # 危险字符（逐字符精确匹配，避免 case 字符类的引号歧义）
        for (( c=0; c<${#bad_chars}; c++ )); do
            case "$n" in
                *"${bad_chars:c:1}"*) echo "  [校验] 更新包成员名含危险字符，已拒绝: $n"; return 1 ;;
            esac
        done
    done <<< "$names"
    return 0
}

# v5.0.0 第7轮 FIX-2：健康检查「可达」判定——放行 2xx 与 3xx（视为可达），
# 避免 apex→www 等正常跳转被误判为失败从而误触发回滚；仍不恢复无限制 -L 盲跟随（只按状态码判定）。
http_reachable() {
    case "$1" in
        2[0-9][0-9]|3[0-9][0-9]) return 0 ;;
        *) return 1 ;;
    esac
}

# v5.0.0：4.x→5.0 数据库结构迁移——调用 webroot 内 ysm-migrate（Python 实现）。
# 定义于顶部函数区：apply-update 自更新会覆盖 /usr/local/bin/ysm-admin 自身，
# 顶部函数体已读入内存，避免「新旧文件混合」解析失败（同 post_update_finish）。
# 用法: run_migration [--db <路径>]；直接流式打印迁移器输出，并返回迁移器退出码
#       （非 0=失败；未找到迁移器 / Python → 返回 127）。
#       外部参数经 "$@" 原样传递，不做字符串插值。
run_migration() {
    local migrator="$WEB_ROOT/ysm-migrate" py=""
    if [ ! -f "$migrator" ]; then
        echo "  [迁移] 错误：未找到迁移器 $migrator" >&2
        return 127
    fi
    if command -v python3 >/dev/null 2>&1; then
        py="python3"
    elif command -v python >/dev/null 2>&1; then
        py="python"
    else
        echo "  [迁移] 错误：未找到 python3（或 python），无法执行迁移" >&2
        return 127
    fi
    "$py" "$migrator" "$@"
    return $?
}

# 判断是否需要执行 4.x→5.0 迁移（幂等）：返回 0=需要，1=无需（已迁移过 / 无库文件）。
#   需要 = 存在旧库 $WEB_ROOT/data/ym.db；或现存库 schema_meta.schema_version ≠ 5.0.0。
#   schema_version 经环境变量传入 php（PHP 侧 getenv 取值），不把库路径插值进 php -r 代码。
schema_needs_migration() {
    local old_db="$WEB_ROOT/data/ym.db" cur_db="$WEB_ROOT/data/ysm.db" ve
    [ -f "$old_db" ] && return 0
    [ -f "$cur_db" ] || return 1           # 无库文件 → 无可迁移对象，跳过
    ver=$(YSM_DB_PATH="$cur_db" php -r '
        $p = getenv("YSM_DB_PATH");
        if ($p === false || $p === "" || !is_file($p)) { exit(0); }
        try {
            $db = new PDO("sqlite:" . $p);
            $db->setAttribute(PDO::ATTR_ERRMODE, PDO::ERRMODE_EXCEPTION);
            $st = $db->prepare("SELECT value FROM schema_meta WHERE key = ?");
            $st->execute(array("schema_version"));
            $v = $st->fetchColumn();
            echo is_string($v) ? $v : "";
        } catch (Exception $e) { exit(0); }
    ' 2>/dev/null)
    [ "$ver" != "5.0.0" ]
}

