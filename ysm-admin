        ALLOW_UNSIGNED=0
        for _a in "$@"; do [ "$_a" = "--allow-unsigned" ] && ALLOW_UNSIGNED=1; done
        REQUEST_FILE="/opt/you-super-markdown/run/ysm-update-request.json"
        # v5.0.1（A4）：移除旧 /tmp 请求文件回退——方案要求"无 /tmp 回退残留"（仅认新共享目录）
        # v5.0.0 P1-4：共享目录自愈——root 创建 root:www-data 0770（www-data 对 /opt/you-super-markdown 无写权限，须由 root 建）
        mkdir -p "$(dirname "$REQUEST_FILE")" 2>/dev/null || true
        chown root:www-data "$(dirname "$REQUEST_FILE")" 2>/dev/null || true
        chmod 770 "$(dirname "$REQUEST_FILE")" 2>/dev/null || true
        if [ ! -f "$REQUEST_FILE" ]; then
            echo "错误：未找到更新请求文件"
            echo "请先在后台管理页面触发更新。"
            exit 1
        fi
        # v5.0.0 P1-4：属主/权限校验——属主须为 root/www-data，且不得对其他用户可写（防本地低权用户篡改更新请求）
        REQ_OWNER=$(stat -c '%U' "$REQUEST_FILE" 2>/dev/null)
        REQ_MODE=$(stat -c '%a' "$REQUEST_FILE" 2>/dev/null)
        case "$REQ_OWNER" in
            root|www-data) ;;
            *)
                echo "错误：更新请求文件属主异常（$REQ_OWNER），已拒绝"
                # v5.0.0 第7轮 FIX-4：详情经环境变量 + getenv() 传入，不把 $REQ_OWNER 插值进 php -r 代码
                YSM_DETAIL="更新请求文件属主异常($REQ_OWNER)，已拒绝" php -r "require_once '$WEB_ROOT/utils.php'; auditLog('update_request_rejected', 'update', getenv('YSM_DETAIL'));" 2>/dev/null || true
                exit 1
                ;;
        esac
        if [ -n "$REQ_MODE" ] && [ $(( 8#$REQ_MODE & 2 )) -ne 0 ]; then
            echo "错误：更新请求文件对其他用户可写（mode $REQ_MODE），已拒绝"
            # v5.0.0 第7轮 FIX-4：详情经环境变量 + getenv() 传入，不把 $REQ_MODE 插值进 php -r 代码
            YSM_DETAIL="更新请求文件 world-writable(mode $REQ_MODE)，已拒绝" php -r "require_once '$WEB_ROOT/utils.php'; auditLog('update_request_rejected', 'update', getenv('YSM_DETAIL'));" 2>/dev/null || true
            exit 1
        fi

        echo "=== You Super Markdown 系统更新 ==="
        echo ""

        STATUS=$(php -r "\$r = json_decode(file_get_contents('$REQUEST_FILE'), true); echo \$r['status'] ?? 'pending';")
        if [ "$STATUS" != "pending" ]; then
            echo "错误：更新请求状态异常 ($STATUS)"
            exit 1
        fi

        # 失败处理统一出口：写 failed 状态 + 重锁母本 + 清理更新锁 + 重启守护
        # v3.2.0：备份已生成且文件已应用时自动回退（恢复 WEB_ROOT + 母本），并记录到 failed 状态
        mark_failed() {
            local reason="$1"
            if [ -n "${BACKUP_FILE:-}" ] && [ -f "$BACKUP_FILE" ] && [ -n "${FILES_APPLIED:-}" ]; then
                auto_rollback "$reason" && reason="$reason（已自动回退）"
            fi
            # v3.2.0：failed 状态写入改 rm + 重建（实测文件 inode 可能被安全防护瞬时锁定，
            # 直接 truncate/open-for-write 报 Permission denied，rm 后重建新文件即可写）
            local now_ts=$(date +%s)
            local reason_esc
            reason_esc=$(printf '%s' "$reason" | sed 's/\\/\\\\/g; s/"/\\"/g')
            rm -f "$REQUEST_FILE" 2>/dev/null || true
            printf '{"status":"failed","from_version":"%s","to_version":"%s","channel":"%s","error":"%s","completed_at":%d}\n' \
                "$FROM_VER" "$TO_VER" "$CHANNEL" "$reason_esc" "$now_ts" > "$REQUEST_FILE" 2>/dev/null || true
            # v5.0.0 P1-4：failed 状态文件 root:www-data 0660（www-data 后台可读，其他用户不可写）
            chown root:www-data "$REQUEST_FILE" 2>/dev/null || true
            chmod 660 "$REQUEST_FILE" 2>/dev/null || true
            chattr -R +i /opt/you-super-markdown/install-base/ 2>/dev/null || true
            rm -f /opt/you-super-markdown/run/ysm-update.lock
            systemctl start ysm-guard 2>/dev/null || true
        }

        FROM_VER=$(php -r "\$r = json_decode(file_get_contents('$REQUEST_FILE'), true); echo \$r['from_version'] ?? '';")
        TO_VER=$(php -r "\$r = json_decode(file_get_contents('$REQUEST_FILE'), true); echo \$r['to_version'] ?? '';")
        CHANNEL=$(php -r "\$r = json_decode(file_get_contents('$REQUEST_FILE'), true); echo \$r['channel'] ?? 'stable';")
        PKG_PATH=$(php -r "\$r = json_decode(file_get_contents('$REQUEST_FILE'), true); echo \$r['package_path'] ?? '';")
        PKG_URL=$(php -r "\$r = json_decode(file_get_contents('$REQUEST_FILE'), true); echo \$r['package_url'] ?? '';")
        # v5.0.0：请求文件字段来自外部，先做字符白名单（防注入/防路径穿越）
        FROM_VER=$(printf '%s' "$FROM_VER" | tr -cd '0-9A-Za-z._-')
        TO_VER=$(printf '%s' "$TO_VER" | tr -cd '0-9A-Za-z._-')
        CHANNEL=$(printf '%s' "$CHANNEL" | tr -cd '0-9A-Za-z._-')
        [ -n "$FROM_VER" ] || FROM_VER="0.0.0"
        if [ -z "$TO_VER" ]; then echo "错误：更新请求缺少合法目标版本号"; exit 1; fi

        # v3.1.15：判定更新方式——PKG_PATH 非空且文件存在 → 后台外部上传更新包；
        # v3.2.0：在线更新选中的仓库包（package_url）→ 在线包更新（仓库下载）
        # v5.0.0：仓库 archive 全量兼容通道已移除，必须由上传包或在线包提供更新源
        if [ -n "$PKG_PATH" ] && [ -f "$PKG_PATH" ]; then
            UPDATE_METHOD="外部上传更新包"
        elif [ -n "$PKG_URL" ]; then
            UPDATE_METHOD="在线包更新（仓库下载）"
        else
            echo "错误：更新请求未提供更新包（package_path / package_url 均为空）"
            mark_failed "更新请求未提供更新包"
            exit 1
        fi

        echo "  当前版本: v$FROM_VER"
        echo "  目标版本: v$TO_VER"
        echo "  更新通道: $CHANNEL"
        echo "  更新方式: $UPDATE_METHOD"
        echo ""

        # 防注入：目标版本仅允许「字母数字 . _ -」（仍禁止引号/空白/斜杠等，杜绝写入 app-config.json 时注入或路径穿越）
        # v5.3.0：放开连字符以支持 beta 语义化版本（如 5.3.1-beta / 5.3.1-beta.2），既有稳定版号不受影响
        if ! [[ "$TO_VER" =~ ^[0-9A-Za-z][0-9A-Za-z._-]*$ ]]; then
            echo "错误：目标版本格式非法，已中止"
            mark_failed "目标版本格式非法"
            exit 1
        fi

        # 标记进行中
        php -r "
            \$r = json_decode(file_get_contents('$REQUEST_FILE'), true);
            \$r['status'] = 'in_progress';
            \$r['started_at'] = time();
            file_put_contents('$REQUEST_FILE', json_encode(\$r, JSON_UNESCAPED_UNICODE|JSON_PRETTY_PRINT), LOCK_EX);
        " 2>/dev/null

        # 1. 备份
        echo "[1/6] 创建备份..."
        BACKUP_DIR="/opt/you-super-markdown/backups"
        mkdir -p "$BACKUP_DIR"
        BK_TS="$(date +%s)"
        BACKUP_FILE="$BACKUP_DIR/pre-update-v${FROM_VER}-${BK_TS}.tar.gz"
        tar -czf "$BACKUP_FILE" -C "$WEB_ROOT" --exclude='data' --exclude='.git' . 2>/dev/null
        # FIX-B：数据库快照——把 data/ 下 ym.db*/ysm.db*（含 -wal/-shm）单独打进「同时间戳」的 DB 备份，
        # 使「更新失败自动回滚」能把库一并回到更新前形态（避免「代码回 4.x、库已是 5.0」的不一致）。
        # 存放于独立子目录 backups/db/，避免被 auto_rollback / 清理里的 pre-update-*.tar.gz 通配误捕。
        DB_BACKUP_DIR="$BACKUP_DIR/db"
        DB_BACKUP_FILE=""
        mkdir -p "$DB_BACKUP_DIR"
        db_files=()
        for db_p in "$WEB_ROOT/data/ym.db" "$WEB_ROOT/data/ym.db-wal" "$WEB_ROOT/data/ym.db-shm" \
                    "$WEB_ROOT/data/ysm.db" "$WEB_ROOT/data/ysm.db-wal" "$WEB_ROOT/data/ysm.db-shm"; do
            [ -e "$db_p" ] && db_files+=("$(basename "$db_p")")
        done
        if [ "${#db_files[@]}" -gt 0 ]; then
            DB_BACKUP_FILE="$DB_BACKUP_DIR/pre-update-db-v${FROM_VER}-${BK_TS}.tar.gz"
            tar -czf "$DB_BACKUP_FILE" -C "$WEB_ROOT/data" "${db_files[@]}" 2>/dev/null || DB_BACKUP_FILE=""
        fi
        echo "  备份: $BACKUP_FILE"
        [ -n "$DB_BACKUP_FILE" ] && echo "  数据库快照: $DB_BACKUP_FILE"

        # 2. 停守护
        echo "[2/6] 停止守护进程..."
        systemctl stop ysm-guard 2>/dev/null || true
        sleep 1

        # 3. 解锁母本
        echo "[3/6] 解锁母本目录..."
        chattr -R -i /opt/you-super-markdown/install-base/ 2>/dev/null || true

        # 4. 应用更新
        echo "[4/6] 应用更新文件..."
        STAGE_DIR=""
        TMP_DIR=""
        PKG_FILE=""
        PKG_TYPE="full"
        FILES_APPLIED=""
        # v5.0.0：两种来源——后台上传包（PKG_PATH）/ 在线更新选中的仓库包（PKG_URL）；仓库 archive 全量通道已移除
        if [ -n "$PKG_PATH" ] && [ -f "$PKG_PATH" ]; then
            echo "  使用上传的更新包: $PKG_PATH"
            PKG_FILE="$PKG_PATH"
        elif [ -n "$PKG_URL" ]; then
            echo "  下载在线更新包（全量/增量包）..."
            PKG_FILE="/tmp/ysm-update-download.tar.gz"
            # v5.0.0：安全下载——逐跳校验目标主机为公网，禁止被重定向到内网（原 -L 自动跟随已移除）
            if ! safe_download "$PKG_URL" "$PKG_FILE"; then
                echo "错误：下载失败，或被重定向到非 http(s)/内网目标"
                rm -f "$PKG_FILE"
                mark_failed "下载失败或重定向到不安全目标"
                exit 1
            fi
        fi

        # 本地包 / 在线包统一：解压 → 定位 STAGE_DIR → 识别全量/增量 → 签名验证
        if [ -n "$PKG_FILE" ]; then
            # v5.0.0 第7轮 FIX-1：先按 magic 字节判定唯一包类型，再「同类型」校验 + 解压（严格成对），
            # 杜绝 polyglot/类型歧义包「校验走一种格式、解压回退另一种格式」绕过成员校验；无法识别即拒绝。
            PKG_FORMAT=$(pkg_detect_type "$PKG_FILE")
            if [ -z "$PKG_FORMAT" ]; then
                echo "错误：更新包格式不受支持（非 gzip/zip），已拒绝"
                rm -f "$PKG_FILE" 2>/dev/null || true
                mark_failed "更新包格式不受支持（非 gzip/zip）"
                exit 1
            fi
            # v5.0.0：解包前先做成员名校验（拒绝 ../绝对路径/软链·硬链），再解压，随后仍走签名验证；
            # 尽量做到「签名通过才落地」：解压仅进 TMP_DIR（未落地 WEB_ROOT），签名通过后才 rsync 落地
            if ! archive_members_safe "$PKG_FILE" "$PKG_FORMAT"; then
                echo "错误：更新包成员名校验失败，已拒绝"
                rm -f "$PKG_FILE" 2>/dev/null || true
                mark_failed "更新包成员名校验失败，已拒绝（可能存在路径穿越/软链）"
                exit 1
            fi
            TMP_DIR=$(mktemp -d)
            # 解压方式与上面的校验方式严格一致（同一 PKG_FORMAT）；失败即封闭，绝不回退到另一种解压器
            case "$PKG_FORMAT" in
                tgz)
                    if ! tar -xzf "$PKG_FILE" -C "$TMP_DIR" 2>/dev/null; then
                        echo "错误：无法解压更新包（tar）"
                        rm -rf "$TMP_DIR"
                        mark_failed "无法解压更新包（tar）"
                        exit 1
                    fi
                    ;;
                zip)
                    if ! unzip -o "$PKG_FILE" -d "$TMP_DIR" >/dev/null 2>&1; then
                        echo "错误：无法解压更新包（unzip）"
                        rm -rf "$TMP_DIR"
                        mark_failed "无法解压更新包（unzip）"
                        exit 1
                    fi
                    ;;
            esac
            # v5.3.0：包类型识别——优先读包内 version.json 的显式 type（full / inc）；
            #   兼容旧值 incremental；type 缺失/未知 → 回退按既有目录结构判定（增量包含 inc/update/ 两层 → inc，否则 full）。
            #   （修复：增量包若含核心文件（utils.php/index.php 等）会被下方「含核心文件=全量包」逻辑误判，
            #    触发 rsync --delete 清空 WEB_ROOT/母本中包外文件，导致站点文件大面积丢失的严重故障）
            VFILE=$(find "$TMP_DIR" -maxdepth 3 -name version.json 2>/dev/null | head -1)
            PKG_TYPE=""
            if [ -n "$VFILE" ]; then
                # v5.0.0 第6轮 C1：包内 version.json 路径经环境变量传入（getenv），不插值进 php -r 代码
                PTYPE=$(YSM_VFILE="$VFILE" php -r '$v = json_decode(@file_get_contents(getenv("YSM_VFILE")), true); echo strtolower(trim((string)($v["type"] ?? "")));' 2>/dev/null)
                case "$PTYPE" in
                    inc|incremental) PKG_TYPE="inc";  STAGE_DIR=$(dirname "$VFILE") ;;
                    full)            PKG_TYPE="full" ;;
                esac
            fi
            # 兼容回退：显式 type 缺失/未知 → 按目录结构判定（存在 inc/update/ 两层即视为增量包）
            if [ -z "$PKG_TYPE" ]; then
                if [ -d "$TMP_DIR/inc/update" ]; then
                    PKG_TYPE="inc"
                    STAGE_DIR="$TMP_DIR/inc/update"
                else
                    PKG_TYPE="full"
                fi
            fi
            # 全量包定位（含核心文件的顶层/子目录；兼容带顶层目录的更新包）
            if [ "$PKG_TYPE" = "full" ] && [ -z "$STAGE_DIR" ]; then
                if [ -f "$TMP_DIR/index.php" ] || [ -f "$TMP_DIR/utils.php" ]; then
                    STAGE_DIR="$TMP_DIR"
                else
                    INNER=$(find "$TMP_DIR" -mindepth 1 -maxdepth 2 \( -name index.php -o -name utils.php \) 2>/dev/null | head -1)
                    if [ -n "$INNER" ]; then
                        STAGE_DIR=$(dirname "$INNER")
                    fi
                fi
            fi
            # v3.2.0：非对称密钥签名验证（v5.0.0 起失败封闭：未部署公钥即拒绝，除显式 --allow-unsigned 引导）
            if [ -n "$STAGE_DIR" ]; then
                if ! verify_package_signature "$TMP_DIR" "$STAGE_DIR"; then
                    rm -rf "$TMP_DIR"
                    mark_failed "更新包签名验证失败，已拒绝（可能被篡改）"
                    exit 1
                fi
            fi
        fi
        # 双保险：全量包必须含核心文件；增量包必须含 version.json（绝不使用 --delete 清空目标）
        if [ -z "$STAGE_DIR" ]; then
            echo "错误：更新源无效（未找到核心文件或增量清单），已中止，未修改任何文件"
            rm -rf "$TMP_DIR" "${PKG_FILE:-}" 2>/dev/null || true
            mark_failed "更新源无效（未找到核心文件或增量清单）"
            exit 1
        fi
        # v5.3.0：跨通道升级/降级判定（禁止降级 / 预发布转正式必须全量包 / 通道收口）——
        #   与检查侧 utils.php:ysmCanUpdate 为同一函数（唯一真源，避免两处逻辑漂移）。
        #   PKG_TYPE 此时已按包内 version.json 识别（full/inc，缺失则回退目录结构），判定在任何文件落地之前完成，失败即拒绝且不改动站点。
        RULE_OUT=$(YSM_FROM="$FROM_VER" YSM_TO="$TO_VER" YSM_PKG="$PKG_TYPE" YSM_CH="$CHANNEL" php -r '
            require_once "'"$WEB_ROOT"'/utils.php";
            $d = ysmCanUpdate(getenv("YSM_FROM"), getenv("YSM_TO"), getenv("YSM_PKG"), getenv("YSM_CH"));
            echo (empty($d["allowed"]) ? "0" : "1") . "\n" . (!empty($d["force_full"]) ? "1" : "0") . "\n" . ($d["code"] ?? "") . "\n" . ($d["reason"] ?? "");
        ' 2>/dev/null)
        RULE_ALLOW=$(printf '%s\n' "$RULE_OUT" | sed -n '1p')
        RULE_CODE=$(printf '%s\n' "$RULE_OUT" | sed -n '3p')
        RULE_REASON=$(printf '%s\n' "$RULE_OUT" | sed -n '4p')
        if [ "$RULE_ALLOW" != "1" ]; then
            [ -n "$RULE_REASON" ] || RULE_REASON="更新被拒绝（跨通道规则）"
            echo "错误：$RULE_REASON"
            rm -rf "$TMP_DIR" "${PKG_FILE:-}" 2>/dev/null || true
            YSM_DETAIL="更新被拒绝（跨通道规则 ${RULE_CODE:-unknown}）：$RULE_REASON" php -r "require_once '$WEB_ROOT/utils.php'; auditLog('update_request_rejected', 'update', getenv('YSM_DETAIL'));" 2>/dev/null || true
            mark_failed "$RULE_REASON"
            exit 1
        fi
        echo "  跨通道规则校验通过：$FROM_VER → $TO_VER（包类型 $PKG_TYPE，通道 $CHANNEL）"
        if [ "$PKG_TYPE" = "inc" ]; then
            if [ ! -f "$STAGE_DIR/version.json" ]; then
                echo "错误：增量包缺少 version.json，已中止，未修改任何文件"
                rm -rf "$TMP_DIR" "${PKG_FILE:-}" 2>/dev/null || true
                mark_failed "增量包缺少 version.json"
                exit 1
            fi
            echo "  增量更新：仅覆盖变更文件，不删除现有文件"
            # v3.3.1-fix：STAGE_DIR 常为 mktemp -d（700），rsync -a 会把 WEB_ROOT/母本目录权限同步为 700
            # 导致 nginx（www-data）无法遍历目录 → 主页 403；统一先固定为 755 再同步
            chmod 755 "$STAGE_DIR" 2>/dev/null || true
            rsync -a --exclude='data/' --exclude='version.json' --exclude='manifest.json*' "$STAGE_DIR/" "$WEB_ROOT/" 2>/dev/null
            rsync -a --exclude='data/' --exclude='version.json' --exclude='manifest.json*' "$STAGE_DIR/" "/opt/you-super-markdown/install-base/" 2>/dev/null
        else
            if [ ! -f "$STAGE_DIR/index.php" ] && [ ! -f "$STAGE_DIR/utils.php" ]; then
                echo "错误：全量更新源无效（缺少 index.php/utils.php），已中止，未修改任何文件"
                rm -rf "$TMP_DIR" "${PKG_FILE:-}" 2>/dev/null || true
                mark_failed "全量更新源无效（缺少核心文件）"
                exit 1
            fi
            # v3.0.0：全量更新排除 app-config.json（服务器配置唯一真源，--delete 不得删除/覆盖）
            # v3.2.0：同时排除签名元数据 manifest.json*
            # v3.3.1-fix：同增量——先固定 STAGE_DIR 目录权限 755，防 rsync -a 覆盖目标目录为 700
            chmod 755 "$STAGE_DIR" 2>/dev/null || true
            rsync -a --delete --exclude='data/' --exclude='app-config.json' --exclude='manifest.json*' "$STAGE_DIR/" "$WEB_ROOT/" 2>/dev/null
            rsync -a --delete --exclude='data/' --exclude='app-config.json' --exclude='manifest.json*' "$STAGE_DIR/" "/opt/you-super-markdown/install-base/" 2>/dev/null
        fi
        # v3.2.0：文件已实际应用，此后失败触发自动回退（此前失败仅标记，文件未被修改）
        FILES_APPLIED="1"
        # 4.7a 提前读取更新包 changelog（v3.1.6：必须在清理 TMP_DIR 前读取，否则 version.json 已不存在；
        # base64 传参规避引号/特殊字符；无 changelog 字段 → 空，后续跳过）
        CHANGELOG_B64=$(YSM_STAGE_DIR="$STAGE_DIR" php -r '
            $vf = rtrim(getenv("YSM_STAGE_DIR"), "/") . "/version.json";
            if (!file_exists($vf)) { exit; }
            $v = json_decode(@file_get_contents($vf), true) ?: [];
            echo base64_encode(trim((string)($v["changelog"] ?? "")));
        ' 2>/dev/null)
        rm -rf "$TMP_DIR" 2>/dev/null || true
        echo "  文件更新完成"

        # 4.4 同步运行中的守护进程与 CLI（安装时复制到 /opt 与 /usr/local/bin，更新时需一并覆盖）
        if [ -f "$WEB_ROOT/ysm-guard.py" ]; then
            cp "$WEB_ROOT/ysm-guard.py" /opt/you-super-markdown/ysm-guard.py 2>/dev/null || true
            chmod 700 /opt/you-super-markdown/ysm-guard.py 2>/dev/null || true
        fi
        if [ -f "$WEB_ROOT/ysm-admin" ]; then
            cp "$WEB_ROOT/ysm-admin" /usr/local/bin/ysm-admin 2>/dev/null || true
            chmod +x /usr/local/bin/ysm-admin 2>/dev/null || true
        fi

        # 4.5 数据库结构迁移（4.x→5.0，按需、幂等）——必须在文件 rsync 落地之后、健康检查/重启服务之前，
        # 且在下方 data 目录 chown 之前执行（迁移会新建/改名 ysm.db，随后的 chown 归位属主）。
        # 时序：守护进程已停（[2/6]）、更新锁生效期间执行，避免与业务写入并发。
        # 失败即 mark_failed → 走既有自动回滚（此刻 FILES_APPLIED 已置位）；已迁移过则跳过。
        if schema_needs_migration; then
            echo "[4.5/6] 数据库结构迁移（4.x → 5.0）..."
            if [ ! -f "$WEB_ROOT/ysm-migrate" ]; then
                echo "错误：需要迁移但未找到迁移器 $WEB_ROOT/ysm-migrate，拒绝继续（失败封闭）"
                mark_failed "需要数据库迁移但缺少 ysm-migrate"
                exit 1
            fi
            MIG_DB="$WEB_ROOT/data/ym.db"
            [ -f "$MIG_DB" ] || MIG_DB="$WEB_ROOT/data/ysm.db"
            if run_migration --db "$MIG_DB"; then
                echo "  数据库迁移完成"
            else
                echo "错误：数据库迁移失败，触发自动回滚"
                mark_failed "数据库结构迁移失败（ysm-migrate）"
                exit 1
            fi
        else
            echo "[4.5/6] 数据库结构已是最新（schema_version=5.0.0），跳过迁移"
        fi

        # 确保 PHP-FPM（www-data）可写 SQLite 及 WAL/SHM 文件；data 目录组可写供 CLI 只读命令无 sudo 读取
        # （v5.0.0：不再执行一次性 JSON→SQLite 迁移脚本；4.x 老库结构迁移见上方 [4.5/6] 自动调用 ysm-migrate）
        chown -R www-data:www-data "$WEB_ROOT/data" 2>/dev/null || true
        chmod 775 "$WEB_ROOT/data" 2>/dev/null || true
        chmod 660 "$WEB_ROOT/data/ysm.db" 2>/dev/null || true

        # 4.6 更新版本号到 web 并同步母本（v3.1.2：必须在 [5/6] 锁定母本前执行——
        # 否则 chattr +i 只读会导致 @copy 失败，母本 app-config.json 停留在旧版本，web↔母本 MD5 不一致）
        php -r "
            \$cfgFile = '$WEB_ROOT/app-config.json';
            if (file_exists(\$cfgFile)) {
                \$c = json_decode(file_get_contents(\$cfgFile), true) ?: [];
                \$c['version'] = '$TO_VER';
                file_put_contents(\$cfgFile, json_encode(\$c, JSON_UNESCAPED_UNICODE|JSON_PRETTY_PRINT), LOCK_EX);
                @copy(\$cfgFile, '/opt/you-super-markdown/install-base/app-config.json');
            }
        " 2>/dev/null

        # v3.3.4：更新后健康检查——主页必须可达（2xx/3xx，仅按状态码判定、不盲跟随跳转）且 web↔母本核心文件 MD5 一致，否则自动回滚
        # （修复：此前仅在脚本步骤失败时回滚；「文件应用成功但站点实际不可用」（如目录权限 700 / rsync 同步异常）
        #  不触发回滚，导致主页 403 等故障未自动恢复）
        echo "[4.8/6] 健康检查..."
        HC_DOMAIN=$(get_domain)
        # v5.0.0 第6轮 H1：健康检查目标域名取自本地可信配置（app-config.json site_url / nginx server_name），
        # 请求即 https，无需盲跟随重定向——关闭 -L，避免被 3xx 引导到非预期目标
        # v5.0.0 第7轮 FIX-2：改为「可达」判定（2xx/3xx 均通过），避免 apex→www 跳转被误判失败而误回滚
        HC_CODE=$(curl -sk -o /dev/null -w '%{http_code}' -A 'YSM-HealthCheck/1.0' "https://$HC_DOMAIN/" 2>/dev/null || echo 000)
        if ! http_reachable "$HC_CODE"; then
            echo "错误：更新后健康检查失败——主页返回 HTTP $HC_CODE，触发自动回滚"
            mark_failed "更新后健康检查失败（主页 HTTP $HC_CODE）"
            exit 1
        fi
        # 核心文件 MD5 校验：web 与母本必须逐字节一致（排除 data/ 与签名元数据）
        HC_BAD=""
        for HC_F in index.php utils.php api.php sc.php app-config.json css/style.css js/main.js ysm-admin ysm-guard.py; do
            HC_A=$(md5sum "$WEB_ROOT/$HC_F" 2>/dev/null | awk '{print $1}')
            HC_B=$(md5sum "/opt/you-super-markdown/install-base/$HC_F" 2>/dev/null | awk '{print $1}')
            if [ -z "$HC_A" ] || [ "$HC_A" != "$HC_B" ]; then
                HC_BAD="$HC_BAD $HC_F"
            fi
        done
        if [ -n "$HC_BAD" ]; then
            echo "错误：更新后健康检查失败——web↔母本 MD5 不一致:$HC_BAD，触发自动回滚"
            mark_failed "更新后健康检查失败（MD5 不一致:$HC_BAD）"
            exit 1
        fi
        echo "  健康检查通过：主页 HTTP $HC_CODE，web↔母本核心文件 MD5 一致"

        # 4.9 环境自检与依赖补装（v3.3.13/v4.5.0）：读取更新包 version.json 声明的 deps 清单
        # + 内置兜底清单自动安装（ffmpeg/php-gd 等）；失败即回滚（保证功能完整）
        echo "[4.9/6] 环境自检与依赖补装..."
        PKG_DEPS=$(pkg_declared_deps "$STAGE_DIR/version.json")
        if ensure_env_deps "$PKG_DEPS"; then
            echo "  [环境] 依赖全部就绪"
        else
            echo "错误：依赖安装失败（内置兜底 + 包内声明：$REQUIRED_DEPS_FALLBACK $PKG_DEPS），触发自动回滚"
            mark_failed "依赖安装失败（$REQUIRED_DEPS_FALLBACK $PKG_DEPS）"
            exit 1
        fi

        # 4.7 更新历史注入（v3.1.9）：changelog 已在 4.7a 提前读取（TMP_DIR 已清理）。
        # 不再逐版本生成独立公告——把本次更新内容写入「更新历史.md」文章（首页公告只保留
        # 一条指向该文章的公告，点进去即可查看全部历史版本更新）。
        # v5.3.0：改为「同版本小节覆盖」（不再重复追加）——已存在 ## v<版本> 则覆盖该小节内容，
        #         不存在则置顶插入（最新在前）；写入幂等（连续执行不产生重复节）。逻辑经环境变量传参。
        # CHANGELOG_B64 为空 → 跳过。
        if [ -n "$CHANGELOG_B64" ]; then
            YSM_ART_PATH="$WEB_ROOT/data/articles/更新历史.md" \
            YSM_CHANGELOG_B64="$CHANGELOG_B64" YSM_TO_VER="$TO_VER" \
            php -r "
                require_once '$WEB_ROOT/utils.php';
                \$artPath = getenv('YSM_ART_PATH');
                \$cl = base64_decode(getenv('YSM_CHANGELOG_B64'));
                \$toVer = getenv('YSM_TO_VER');
                // 1) 同版本覆盖 / 新版本置顶（幂等），文章不存在则建骨架
                injectChangelogIntoArticle(\$artPath, \$toVer, \$cl);
                // 2) 清理历史逐版本 update 公告，确保首页只保留一条指向更新历史文章的公告
                db_exec(\"DELETE FROM announcement WHERE type = 'update'\");
                if (!db_one('SELECT 1 FROM announcement WHERE article = ? LIMIT 1', ['更新历史.md'])) {
                    addAnnouncement('manual', '更新历史.md', '', '更新历史', '全部版本更新记录整合于此，点击查看完整更新历史');
                }
            " 2>/dev/null
            chown www-data:www-data "$WEB_ROOT/data/articles/更新历史.md" 2>/dev/null || true
        fi

        # 5. 锁定母本（更新包可能已覆盖 install-base；锁定防篡改）
        echo "[5/6] 锁定母本目录..."
        chattr -R +i /opt/you-super-markdown/install-base/ 2>/dev/null || true

        # 6. 重启全部服务 + 重启后复检（v4.6.0：更新完成 → 重启 nginx/php-fpm/守护全部服务 → 重启后验证主页可访问与功能正常 → 才标记完成并邮件）
        echo "[6/6] 重启全部服务并复检..."
        # 6.1 重启 PHP-FPM（动态探测版本）与 Nginx
        PHPFPM_SVC=""
        for f in "php$(php -r 'echo PHP_MAJOR_VERSION.".".PHP_MINOR_VERSION;' 2>/dev/null)-fpm" php-fpm php8.3-fpm php8.2-fpm php8.1-fpm; do
            if systemctl list-unit-files "$f.service" 2>/dev/null | grep -q "$f"; then PHPFPM_SVC="$f"; break; fi
        done
        if [ -n "$PHPFPM_SVC" ]; then
            systemctl restart "$PHPFPM_SVC" 2>/dev/null && echo "  已重启 PHP-FPM（$PHPFPM_SVC）" || echo "  警告：PHP-FPM 重启失败（$PHPFPM_SVC）"
        fi
        if systemctl list-unit-files nginx.service 2>/dev/null | grep -q nginx; then
            systemctl restart nginx 2>/dev/null && echo "  已重启 Nginx" || echo "  警告：Nginx 重启失败"
        fi
        # 6.2 重启守护进程（更新包可能已更新 ysm-guard.py，重启使新代码生效）
        systemctl restart ysm-guard 2>/dev/null && echo "  已重启守护进程" || echo "  警告：守护进程重启失败"
        rm -f /opt/you-super-markdown/run/ysm-update.lock
        # 6.3 重启后复检：主页/API 可达（2xx/3xx）+ web↔母本 MD5 一致（任一失败 → 自动回滚 + 告警邮件）
        sleep 2
        RC_DOMAIN=$(get_domain)
        # v5.0.0 第6轮 H1：同上——目标取自本地可信配置，关闭 -L 盲跟随
        # v5.0.0 第7轮 FIX-2：主页/API 均按「可达」判定（2xx/3xx 通过），避免跳转误判触发误回滚
        RC_HOME=$(curl -sk -o /dev/null -w '%{http_code}' -A 'YSM-HealthCheck/1.0' "https://$RC_DOMAIN/" 2>/dev/null || echo 000)
        RC_API=$(curl -sk -o /dev/null -w '%{http_code}' -A 'YSM-HealthCheck/1.0' "https://$RC_DOMAIN/api.php?action=csrf" 2>/dev/null || echo 000)
        RC_BAD=""
        for RC_F in index.php utils.php api.php sc.php app-config.json css/style.css js/main.js ysm-admin ysm-guard.py; do
            RC_A=$(md5sum "$WEB_ROOT/$RC_F" 2>/dev/null | awk '{print $1}')
            RC_B=$(md5sum "/opt/you-super-markdown/install-base/$RC_F" 2>/dev/null | awk '{print $1}')
            if [ -z "$RC_A" ] || [ "$RC_A" != "$RC_B" ]; then
                RC_BAD="$RC_BAD $RC_F"
            fi
        done
        if ! http_reachable "$RC_HOME" || ! http_reachable "$RC_API" || [ -n "$RC_BAD" ]; then
            echo "错误：重启后复检失败（主页 HTTP $RC_HOME / API HTTP $RC_API / MD5 差异:$RC_BAD），触发自动回滚"
            mark_failed "重启后复检失败（主页 HTTP $RC_HOME / API HTTP $RC_API）"
            exit 1
        fi
        echo "  重启后复检通过：主页 HTTP $RC_HOME，API HTTP $RC_API，web↔母本 MD5 一致"
        # 6.4 写审计日志 + 标记完成 + 更新通知邮件（含本次更新内容/更新方式）
        YSM_UTILS="$WEB_ROOT/utils.php" YSM_FROM_VER="$FROM_VER" YSM_TO_VER="$TO_VER" php -r '
            require_once getenv("YSM_UTILS");
            auditLog("system_update", "", "系统更新: v" . getenv("YSM_FROM_VER") . " → v" . getenv("YSM_TO_VER"));
        ' 2>/dev/null
        # v3.1.0：收尾逻辑抽到顶部函数（自更新后 case 内联代码会混合解析失败）
        # v3.1.7：把 changelog（4.7a 已读取）传给收尾函数，更新通知邮件附带本次更新内容
        # v3.1.15：把更新方式（外部上传更新包 / 在线包更新）传给收尾函数，邮件展示更新通道
        post_update_finish "$TO_VER" "$CHANNEL" "$FROM_VER" "$CHANGELOG_B64" "$UPDATE_METHOD"
        # 自更新已覆盖本脚本文件：立即退出，避免 bash 继续解析磁盘上的新内容导致混合语法错误
        exit 0
        ;;

    rollback)
        BACKUP_DIR="/opt/you-super-markdown/backups"
        if [ ! -d "$BACKUP_DIR" ] || [ -z "$(ls -A "$BACKUP_DIR"/pre-update-*.tar.gz 2>/dev/null)" ]; then
            echo "错误：没有可用的备份"
            exit 1
        fi

        echo "=== 可用备份 ==="
        echo ""
        I=1
        for B in $(ls -t "$BACKUP_DIR"/pre-update-*.tar.gz 2>/dev/null); do
            BASENAME=$(basename "$B")
            SIZE=$(du -h "$B" | cut -f1)
            if [[ $BASENAME =~ pre-update-v([0-9.]+)-([0-9]+)\.tar\.gz ]]; then
                VER="${BASH_REMATCH[1]}"
                TS=$(date -d @"${BASH_REMATCH[2]}" '+%Y-%m-%d %H:%M:%S' 2>/dev/null || echo "unknown")
                echo "  [$I] v$VER ($TS) - $SIZE"
            else
                echo "  [$I] $BASENAME - $SIZE"
            fi
            I=$((I+1))
        done
        echo ""
        echo "要回滚到哪个备份？(输入编号)"
        read -r CHOICE
        SELECTED=$(ls -t "$BACKUP_DIR"/pre-update-*.tar.gz 2>/dev/null | sed -n "${CHOICE}p")
        if [ -z "$SELECTED" ]; then
            echo "错误：无效选择"
            exit 1
        fi

        echo ""
        echo "正在回滚到: $(basename "$SELECTED")"
        echo ""

        echo "[1/3] 停止守护进程..."
        systemctl stop ysm-guard 2>/dev/null || true
        sleep 1

        # 解锁母本，恢复完成后重新锁定（避免 +i 只读导致 rsync 失败/母本与 web 不一致）
        chattr -R -i /opt/you-super-markdown/install-base/ 2>/dev/null || true

        echo "[2/3] 恢复文件..."
        tar -xzf "$SELECTED" -C "$WEB_ROOT" 2>/dev/null
        rsync -a --delete --exclude='data/' "$WEB_ROOT/" "/opt/you-super-markdown/install-base/" 2>/dev/null
        chattr -R +i /opt/you-super-markdown/install-base/ 2>/dev/null || true
        echo "  文件恢复完成"

        echo "[3/3] 重启守护进程..."
        systemctl start ysm-guard 2>/dev/null || true
        rm -f /opt/you-super-markdown/run/ysm-update.lock

        echo ""
        echo "============================================"
        echo "  回滚完成！"
        echo "============================================"
        ;;

    hfish-panel)
        PORTS_FILE="/opt/you-super-markdown/hfish-ports.conf"
        if [ ! -f "$PORTS_FILE" ]; then
            echo "Hfish 未安装或配置文件不存在"
            exit 1
        fi
        source "$PORTS_FILE"
        PANEL_PORT="${HFISH_PANEL_PORT:-4433}"
        echo ""
        echo "============================================"
        echo "  Hfish 管理面板隧道已建立"
        echo "============================================"
        echo ""
        echo "  本地访问地址: http://127.0.0.1:${PANEL_PORT}"
        echo ""
        echo "  请在本地浏览器中打开上述地址"
        echo "  按 Ctrl+C 关闭隧道"
        echo "============================================"
        echo ""
        ssh -L "${PANEL_PORT}:127.0.0.1:${PANEL_PORT}" -N root@127.0.0.1
        ;;

    hfish-status)
        echo "=== Hfish 蜜罐状态 ==="
        echo ""
        PORTS_FILE="/opt/you-super-markdown/hfish-ports.conf"
        if [ -f "$PORTS_FILE" ]; then
            source "$PORTS_FILE"
            echo "配置端口:"
            echo "  管理面板: ${HFISH_PANEL_PORT:-4433}"
            echo "  节点通信: ${HFISH_NODE_PORT:-4434}"
            echo "  蜜獾账户: ${HFISH_USER:-xiao}"
        else
            echo "  端口配置文件不存在"
        fi
        echo ""
        echo "服务状态:"
        if systemctl is-active --quiet hfish 2>/dev/null; then
            echo "  hfish.service: 运行中"
        else
            echo "  hfish.service: 未运行"
        fi
        ;;

    *)
        echo "You Super Markdown CLI 管理工具"
        echo ""
        echo "用法: ysm-admin <命令> [参数]"
        echo ""
        echo "命令:"
        echo "  login                    生成 OTP 管理入口"
        echo "  create-station <名称>     创建站长账号"
        echo "  create-author <名称>      创建写作者账号"
        echo "  revoke-user <用户ID>      吊销用户"
        echo "  backup                    备份数据"
        echo "  status                    查看服务状态"
        echo "  log-verify                校验审计日志哈希链"
        echo "  audit-report              每日审计报告（校验结果经 SMTP 发送给管理员）"
        echo "  challenge                 生成挑战码"
        echo "  notify <消息>              发送通知邮件到管理员（测试/更新/运维消息）"
        echo "  set-smtp-pass [--pass=授权码] 修改 SMTP 授权码（需 sudo；密钥文件 + php-fpm 环境变量双写，自动发测试邮件）"
        echo "  apply-update [--allow-unsigned] 执行系统更新（完成后自动发通知邮件；--allow-unsigned 为一次性受控引导，未部署签名公钥时慎用）"
        echo "  deps                      检查并一键补装功能依赖（内置兜底清单，需 sudo；更新时自动按包内 deps 声明安装）"
        echo "  set-channel <stable|beta> 切换更新通道（别名 channel；stable=仅正式 Release / beta=含预发布）"
        echo "  check [--no-mail]         体检：超管邮箱 / SMTP / php-fpm 是否注入 YSM_SMTP_PASS / 能否发测试邮件"
        echo "  cleanup-history           一次性清理「更新历史.md」中同一版本的重复小节（先备份，仅动重复节）"
        echo "  migrate [--db <路径>]      迁移 4.x 数据库结构到 5.0（需 sudo；不重启服务，完成后请重启守护进程）"
        echo "  rollback                  回滚到备份版本"
        echo "  hfish-panel               建立 SSH 隧道访问 Hfish 管理面板"
        echo "  hfish-status              查看 Hfish 蜜罐状态"
        echo ""
        echo "环境变量:"
        echo "  YSM_WEB_ROOT               Web 根目录 (默认 /var/www/you-super-markdown)"
        ;;
esac