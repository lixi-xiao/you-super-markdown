def resolve_db_path(arg_db):
    """定位数据库文件：优先命令行参数，其次 data/ym.db，再次 data/ysm.db。"""
    if arg_db:
        return os.path.abspath(arg_db)
    script_dir = os.path.dirname(os.path.abspath(__file__))
    data_dir = os.path.join(script_dir, "data")
    for name in ("ym.db", "ysm.db"):
        p = os.path.join(data_dir, name)
        if os.path.exists(p):
            return p
    # 都不存在时，返回默认路径供报错提示
    return os.path.join(data_dir, "ym.db")


def make_backup(db_path):
    """用 SQLite 在线备份 API 生成一致性备份；已存在同名备份则追加时间戳。"""
    base = db_path + ".pre-5.0.bak"
    backup_path = base
    if os.path.exists(backup_path):
        stamp = time.strftime("%Y%m%d-%H%M%S")
        backup_path = "{}.{}".format(base, stamp)
    src = sqlite3.connect(db_path)
    try:
        dst = sqlite3.connect(backup_path)
        try:
            src.backup(dst)  # 生成一致性快照（自动处理 WAL）
        finally:
            dst.close()
    finally:
        src.close()
    return backup_path


def restore_backup(db_path, backup_path):
    """回滚：删除当前库及其 WAL 侧车文件，再从备份还原主库文件。"""
    for suffix in ("", "-wal", "-shm"):
        p = db_path + suffix
        if os.path.exists(p):
            try:
                os.remove(p)
            except OSError:
                pass
    shutil.copy2(backup_path, db_path)


def table_columns(con, table):
    """返回表的所有列名（表不存在时返回空列表）。"""
    rows = con.execute('PRAGMA table_info("{}")'.format(table)).fetchall()
    return [r[1] for r in rows]


def rebuild_table(con, spec):
    """按 5.0 结构重建单张表，返回搬迁的行数（-1 表示源表不存在，未拷贝）。"""
    table = spec["name"]
    new_name = "__new__" + table

    con.execute('DROP TABLE IF EXISTS "{}"'.format(new_name))
    con.execute('CREATE TABLE "{}" ({})'.format(new_name, ", ".join(spec["body"])))

    old_cols = table_columns(con, table)
    copied = -1
    if old_cols:
        rename = spec.get("rename", {})
        pairs = []
        for col in spec["columns"]:
            # 解析源列：优先 rename 候选，其次同名列
            candidates = rename.get(col, [col])
            src = next((c for c in candidates if c in old_cols), None)
            if src is not None:
                pairs.append((col, src))
        if pairs:
            dst_sql = ", ".join('"{}"'.format(c) for c, _ in pairs)
            src_sql = ", ".join('"{}"'.format(s) for _, s in pairs)
            con.execute('INSERT INTO "{}" ({}) SELECT {} FROM "{}"'.format(
                new_name, dst_sql, src_sql, table))
            copied = con.execute('SELECT COUNT(*) FROM "{}"'.format(new_name)).fetchone()[0]

    # 删旧表 → 新表改名 → 重建索引
    con.execute('DROP TABLE IF EXISTS "{}"'.format(table))
    con.execute('ALTER TABLE "{}" RENAME TO "{}"'.format(new_name, table))
    for idx_sql in spec.get("indexes", []):
        con.execute(idx_sql.format(t=table))
    return copied


def migrate(db_path):
    con = sqlite3.connect(db_path)
    con.isolation_level = None  # 手动控制事务边界
    summary = []
    con.execute("BEGIN")
    try:
        for spec in TABLES:
            copied = rebuild_table(con, spec)
            summary.append((spec["name"], copied))

        # 写入 schema_meta 版本标记（供 db.php / 后续迁移判断）
        con.execute(
            "INSERT OR REPLACE INTO schema_meta (key, value) VALUES ('schema_version', ?)",
            (SCHEMA_VERSION,))
        con.execute(
            "INSERT OR REPLACE INTO schema_meta (key, value) VALUES ('epoch', ?)",
            (SCHEMA_EPOCH,))
        con.execute("COMMIT")
    except Exception:
        try:
            con.execute("ROLLBACK")
        except Exception:
            pass
        con.close()
        raise

    # 落盘 WAL，关闭连接，保证后续改名/备份的文件内容完整
    try:
        con.execute("PRAGMA wal_checkpoint(TRUNCATE)")
    except Exception:
        pass
    con.close()
    return summary


def rename_to_ysm(db_path):
    """若文件名仍为 ym.db，则改名为 ysm.db（含 WAL 侧车文件）。返回最终路径。"""
    if os.path.basename(db_path) != "ym.db":
        return db_path
    target = os.path.join(os.path.dirname(db_path), "ysm.db")
    if os.path.exists(target):
        print("[warn] 目标 ysm.db 已存在，跳过改名（请人工确认）")
        return db_path
    os.rename(db_path, target)
    for suffix in ("-wal", "-shm"):
        if os.path.exists(db_path + suffix):
            os.rename(db_path + suffix, target + suffix)
    return target


def main():
    parser = argparse.ArgumentParser(
        description="You Super Markdown 4.x → 5.0 数据库结构迁移器")
    parser.add_argument("--db", default=None, help="数据库文件路径（默认 data/ym.db）")
    args = parser.parse_args()

    db_path = resolve_db_path(args.db)
    if not os.path.exists(db_path):
        print("[error] 未找到数据库文件：{}".format(db_path))
        print("        可用 --db <路径> 指定要迁移的数据库。")
        sys.exit(1)

    print("[info] 待迁移数据库：{}".format(db_path))
    print("[info] 目标 schema 版本：{} (epoch={})".format(SCHEMA_VERSION, SCHEMA_EPOCH))

    # 第 2 步：备份
    backup_path = make_backup(db_path)
    print("[ok]   备份完成：{}".format(backup_path))

    # 第 3~4 步：事务内重建结构 + 写 schema_meta
    try:
        summary = migrate(db_path)
    except Exception as e:
        print("[error] 迁移失败，正在回滚到备份……原因：{}".format(e))
        try:
            restore_backup(db_path, backup_path)
            print("[ok]   已回滚到备份：{}".format(backup_path))
        except Exception as re:
            print("[fatal] 回滚失败，请手动用备份恢复：{}（原因：{}）".format(backup_path, re))
        sys.exit(1)

    # 第 5 步：文件改名 ym.db → ysm.db
    final_path = rename_to_ysm(db_path)

    # 第 7 步：结果摘要
    print("-" * 56)
    print("[done] 迁移完成。")
    total = 0
    for name, copied in summary:
        if copied < 0:
            print("       - {:<22} 新建（源表不存在）".format(name))
        else:
            total += copied
            print("       - {:<22} 搬迁 {} 行".format(name, copied))
    print("[info] 共 {} 张表，累计搬迁 {} 行。".format(len(summary), total))
    print("[info] 备份文件：{}".format(backup_path))
    print("[info] 最终数据库：{}".format(final_path))
    print("[info] schema_meta：schema_version={}, epoch={}".format(SCHEMA_VERSION, SCHEMA_EPOCH))


if __name__ == "__main__":
    main()
